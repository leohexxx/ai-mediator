.chat-panel { margin-top: 38rpx; padding: 28rpx 24rpx 22rpx; }
.chat-header { display: flex; align-items: center; padding-bottom: 23rpx; border-bottom: 1rpx solid var(--color-border); }
.chat-header-seal { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; margin-right: 17rpx; color: #29252A; background: var(--color-accent); border-radius: 50%; font-size: 20rpx; font-weight: 800; transform: rotate(-5deg); }
.chat-header-title { color: var(--color-text-primary); font-family: 'Songti SC','STSong','SimSun',serif; font-size: 29rpx; font-weight: 700; }
.chat-header-sub { margin-top: 2rpx; color: var(--color-text-muted); font-size: 19rpx; }
.chat-messages { height: 600rpx; padding: 24rpx 0; box-sizing: border-box; }
.chat-empty { padding: 110rpx 30rpx; font-size: 23rpx; text-align: center; }
.msg-row { display: flex; align-items: flex-end; margin-bottom: 22rpx; }
.msg-user { justify-content: flex-end; }
.message-avatar { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border: 1rpx solid var(--color-border-light); border-radius: 50%; color: var(--color-text-secondary); background: var(--color-card); font-size: 17rpx; font-weight: 700; }
.message-avatar.ai { margin-right: 10rpx; color: #29252A; background: var(--color-accent); border-color: var(--color-accent); }
.message-avatar.user { margin-left: 10rpx; color: #F8F3EC; background: var(--color-brand-dark); border-color: var(--color-brand-dark); }
.msg-bubble { max-width: 74%; padding: 18rpx 22rpx; box-sizing: border-box; color: var(--color-text-primary); background: var(--color-bubble-ai); border: 1rpx solid var(--color-bubble-ai-border); border-radius: 8rpx 20rpx 20rpx 20rpx; font-size: 24rpx; line-height: 1.65; word-break: break-all; }
.msg-user .msg-bubble { color: #F8F3EC; background: var(--color-bubble-user); border-color: var(--color-bubble-user); border-radius: 20rpx 8rpx 20rpx 20rpx; }
.cursor-blink { color: var(--color-accent); animation: blink .8s steps(2) infinite; }
@keyframes blink { 50% { opacity: 0; } }
.typing-indicator { display: flex; align-items: center; gap: 8rpx; min-width: 76rpx; }
.typing-dot { width: 8rpx; height: 8rpx; background: var(--color-text-muted); border-radius: 50%; animation: typing 1.2s infinite ease-in-out; }
.typing-dot:nth-child(2) { animation-delay: .15s; }
.typing-dot:nth-child(3) { animation-delay: .3s; }
@keyframes typing { 0%,60%,100% { transform: translateY(0); opacity: .45; } 30% { transform: translateY(-6rpx); opacity: 1; } }
.chat-input-area { display: flex; align-items: center; gap: 12rpx; padding-top: 18rpx; border-top: 1rpx solid var(--color-border); }
.chat-input { flex: 1; height: 78rpx; padding: 0 22rpx; box-sizing: border-box; color: var(--color-text-primary); background: rgba(255,255,255,.04); border: 1rpx solid var(--color-border); border-radius: var(--radius-md); font-size: 24rpx; }
.input-placeholder { color: var(--color-text-muted); }
.send-btn { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; color: var(--color-text-muted); background: var(--color-card-hover); border-radius: var(--radius-md); font-size: 23rpx; }
.send-btn.active { color: #F8F3EC; background: var(--color-brand); }
