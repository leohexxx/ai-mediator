/* 聊天追问面板样式 */
.chat-panel {
  margin-bottom: 24rpx;
  padding-bottom: 0;
}

.chat-header {
  font-size: var(--font-md);
  font-weight: var(--font-semibold);
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.chat-messages {
  height: 500rpx;
  box-sizing: border-box;
}

.chat-empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: var(--font-sm);
}

.msg-row {
  margin-bottom: 20rpx;
  display: flex;
}

.msg-user {
  justify-content: flex-end;
}

.msg-ai {
  justify-content: flex-start;
}

.msg-bubble {
  max-width: 75%;
  padding: 18rpx 24rpx;
  border-radius: var(--radius-lg);
  font-size: var(--font-sm);
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.msg-user .msg-bubble {
  background: var(--color-bubble-user);
  color: #fff;
  border-top-right-radius: 4rpx;
}

.msg-ai .msg-bubble {
  background: var(--color-bubble-ai);
  color: var(--color-text-primary);
  border: 1rpx solid var(--color-bubble-ai-border);
  border-top-left-radius: 4rpx;
}

.cursor-blink {
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

/* 输入中指示器 */
.typing-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 28rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  background: var(--color-text-muted);
  border-radius: 50%;
  animation: typing 1.4s infinite;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typing {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.3; }
  30% { transform: translateY(-8rpx); opacity: 1; }
}

/* 输入区 */
.chat-input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--color-border);
  margin-top: 16rpx;
  padding-top: 20rpx;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: var(--color-bg-secondary);
  border-radius: var(--radius-full);
  padding: 0 24rpx;
  font-size: var(--font-sm);
  color: var(--color-text-primary);
}

.input-placeholder {
  color: var(--color-text-muted);
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  border-radius: 50%;
  font-size: 32rpx;
  opacity: 0.4;
  transition: var(--transition-fast);
}

.send-btn.active {
  opacity: 1;
  background: var(--color-brand);
}
