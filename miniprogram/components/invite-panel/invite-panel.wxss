/* 邀请面板样式 */
.invite-panel {
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(99, 102, 241, 0.3);
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.08), rgba(236, 72, 153, 0.05));
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.panel-title {
  font-size: var(--font-lg);
  font-weight: var(--font-semibold);
  color: var(--color-text-primary);
}

.invite-code-section {
  text-align: center;
  margin-bottom: 24rpx;
}

.invite-label {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  margin-bottom: 8rpx;
}

.invite-code {
  font-size: 64rpx;
  font-weight: var(--font-bold);
  color: var(--color-brand);
  letter-spacing: 16rpx;
  font-family: 'Courier New', monospace;
  margin-bottom: 16rpx;
}

.copy-btn {
  display: inline-block;
}

.qrcode-section {
  text-align: center;
  margin-bottom: 24rpx;
}

.qrcode-placeholder {
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto;
  background: var(--color-card);
  border: 1rpx dashed var(--color-border);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.qrcode-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
  opacity: 0.5;
}

.qrcode-text {
  font-size: var(--font-sm);
}

.qrcode-hint {
  font-size: var(--font-xs);
  margin-top: 4rpx;
}

.qrcode-image {
  width: 280rpx;
  height: 280rpx;
}

.panel-actions {
  text-align: center;
}

.panel-actions .btn-primary {
  width: 100%;
}
