/* 证据操作区样式 */
.evidence-section {
  margin-bottom: 24rpx;
}

.evidence-section .section-title {
  font-size: var(--font-md);
  font-weight: var(--font-semibold);
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
}

.evidence-empty {
  text-align: center;
  padding: 16rpx 0;
}

.empty-text {
  font-size: var(--font-sm);
  margin-bottom: 20rpx;
}

.evidence-btn {
  display: inline-block;
  min-width: 280rpx;
}

.evidence-submitted {
  /* */
}

.submitted-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.submitted-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.submitted-text {
  font-size: var(--font-md);
  color: var(--color-text-primary);
}

.evidence-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.evidence-actions .btn-ghost.disabled {
  opacity: 0.4;
}
