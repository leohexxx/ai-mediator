<!-- 原版评理卡片视觉 + V3 证据字段 -->
<view class="core-verdict card" wx:if="{{coreConclusion}}">
  <view class="verdict-header">
    <view class="verdict-icon">AI</view>
    <view class="verdict-title">这波谁更有理？</view>
  </view>

  <view class="winner-badge">AI 已根据现有证据帮你捋清重点</view>
  <view class="verdict-text">{{summary}}</view>

  <view class="key-reasons" wx:if="{{disputedIssues.length > 0}}">
    <view class="reasons-title">DISPUTE / 争议焦点</view>
    <view wx:for="{{disputedIssues}}" wx:key="id" class="reason-item">
      <text class="reason-dot">•</text>
      <text>{{item.title || item}}</text>
    </view>
  </view>

  <view class="key-reasons" wx:if="{{commonGround.length > 0}}">
    <view class="reasons-title">COMMON / 双方都能确认的事</view>
    <view wx:for="{{commonGround}}" wx:key="*this" class="reason-item">
      <text class="reason-dot">•</text>
      <text>{{item}}</text>
    </view>
  </view>

  <view class="key-reasons missing-evidence" wx:if="{{missingEvidence.length > 0}}">
    <view class="reasons-title">MISSING / 还缺什么</view>
    <view wx:for="{{missingEvidence}}" wx:key="*this" class="reason-item">
      <text class="reason-dot">•</text>
      <text>{{item}}</text>
    </view>
  </view>

  <view class="confidence-section">
    <view class="confidence-header">
      <text>CONFIDENCE / 证据把握度：{{confidenceLevel}}（{{confidence}}%）</text>
    </view>
    <view class="confidence-bar-wrapper">
      <view class="confidence-bar">
        <view class="confidence-fill {{confidence >= 75 ? 'high' : confidence >= 50 ? 'medium' : 'low'}}" style="width: {{confidence}}%"></view>
      </view>
    </view>
    <view wx:for="{{confidenceReasons}}" wx:key="*this" class="confidence-reason text-secondary">{{item}}</view>
  </view>

  <view class="action-section" wx:if="{{nextActions.length > 0}}">
    <view class="action-label">NEXT / 下一步怎么做</view>
    <view wx:for="{{nextActions}}" wx:key="*this" class="action-text">{{index + 1}}. {{item}}</view>
  </view>
</view>
