<view class="report-core" wx:if="{{coreConclusion}}">
  <view class="report-label">EVIDENCE-BASED SUMMARY</view>
  <view class="report-title">现有证据说明了什么</view>
  <view class="summary-text">{{summary}}</view>

  <view class="risk-notice" wx:if="{{riskNotice}}">
    <view class="risk-label">优先留意</view>
    <view>{{riskNotice}}</view>
  </view>

  <view class="quality-panel">
    <view class="quality-top">
      <view>
        <view class="quality-label">证据充分度</view>
        <view class="quality-value">{{confidenceLevel}}</view>
      </view>
      <view class="quality-score">{{confidence}}<text>/100</text></view>
    </view>
    <view class="quality-track"><view class="quality-fill" style="width: {{confidence}}%"></view></view>
    <view class="single-party" wx:if="{{isSinglePartyEvidence}}">当前为单方证据，系统已限制置信度上限。</view>
    <view class="basis-row" wx:if="{{analysisBasis.messageCount}}">
      <text>{{analysisBasis.messageCount}} 条消息</text>
      <text>{{analysisBasis.factCount || 0}} 项规则提取事实</text>
      <text>版本 {{analysisBasis.promptVersion || 'V3'}}</text>
    </view>
    <view class="reason-item" wx:for="{{confidenceReasons}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="report-section" wx:if="{{commonGround.length}}">
    <view class="section-number">01</view>
    <view class="section-heading">可以共同确认</view>
    <view class="line-item positive" wx:for="{{commonGround}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="report-section" wx:if="{{disputedIssues.length}}">
    <view class="section-number">02</view>
    <view class="section-heading">仍有分歧</view>
    <view class="dispute-item" wx:for="{{disputedIssues}}" wx:key="id">
      <view class="dispute-title">{{item.title || item}}</view>
      <view class="party-view" wx:if="{{item.partyAView}}"><text>甲方：</text>{{item.partyAView}}</view>
      <view class="party-view" wx:if="{{item.partyBView}}"><text>乙方：</text>{{item.partyBView}}</view>
      <view class="uncertainty" wx:if="{{item.uncertainty}}">未确定：{{item.uncertainty}}</view>
    </view>
  </view>

  <view class="report-section missing" wx:if="{{missingEvidence.length}}">
    <view class="section-number">03</view>
    <view class="section-heading">还缺什么</view>
    <view class="line-item" wx:for="{{missingEvidence}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="report-section actions" wx:if="{{nextActions.length}}">
    <view class="section-number">04</view>
    <view class="section-heading">建议下一步</view>
    <view class="action-item" wx:for="{{nextActions}}" wx:key="*this">
      <text class="action-number">{{index + 1}}</text>
      <text class="action-copy">{{item}}</text>
    </view>
  </view>
</view>
