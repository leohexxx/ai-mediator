/* 核心结论卡片样式 */
.core-verdict {
  border: 1rpx solid rgba(194, 160, 90, 0.24);
}

.verdict-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.verdict-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  color: #29252A;
  background: var(--color-accent);
  border-radius: 50%;
  font-size: 18rpx;
  font-weight: 800;
  margin-right: 12rpx;
}

.verdict-title {
  font-size: var(--font-lg);
  font-weight: var(--font-bold);
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  color: var(--color-text-primary);
}

/* 分数对比 */
.score-compare {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.score-side {
  text-align: center;
  min-width: 100rpx;
}

.score-label {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
  margin-bottom: 4rpx;
}

.score-value {
  font-size: var(--font-xl);
  font-weight: var(--font-bold);
}

.score-bar-wrapper {
  flex: 1;
  padding: 0 16rpx;
}

.score-bar {
  display: flex;
  height: 16rpx;
  border-radius: var(--radius-full);
  overflow: hidden;
  background: var(--color-border);
}

.score-fill-a,
.score-fill-b {
  height: 100%;
  transition: width 0.6s ease;
}

.winner-badge {
  text-align: center;
  font-size: var(--font-lg);
  font-weight: var(--font-bold);
  color: var(--color-brand);
  margin-bottom: 12rpx;
}

.verdict-text {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  background: rgba(169, 79, 96, 0.08);
  border-radius: var(--radius-sm);
  border-left: 4rpx solid var(--color-brand);
}

/* 核心原因 */
.key-reasons {
  margin-bottom: 24rpx;
}

.reasons-title {
  font-size: var(--font-sm);
  font-weight: var(--font-medium);
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.reason-item {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
  padding: 6rpx 0;
}

.reason-dot {
  color: var(--color-brand);
  margin-right: 8rpx;
}

/* 置信度 */
.confidence-section {
  margin-bottom: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
}

.confidence-header {
  font-size: var(--font-sm);
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}

.confidence-bar-wrapper {
  margin-bottom: 12rpx;
}

.confidence-bar {
  height: 12rpx;
  background: var(--color-border);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.confidence-fill {
  height: 100%;
  border-radius: var(--radius-full);
  transition: width 0.6s ease;
}

.confidence-fill.high {
  background: var(--color-success);
}

.confidence-fill.medium {
  background: var(--color-warning);
}

.confidence-fill.low {
  background: var(--color-error);
}

.confidence-reason {
  font-size: var(--font-xs);
  line-height: 1.5;
  margin-bottom: 4rpx;
}

/* 建议行动 */
.action-section {
  padding: 24rpx;
  background: var(--color-success-bg);
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(142, 155, 128, 0.28);
}

.action-label {
  font-size: var(--font-sm);
  font-weight: var(--font-medium);
  color: var(--color-success);
  margin-bottom: 8rpx;
}

.action-text {
  font-size: var(--font-md);
  color: var(--color-text-primary);
  line-height: 1.6;
}

.missing-evidence {
  padding: 18rpx 20rpx;
  background: var(--color-warning-bg);
  border: 1rpx dashed var(--color-warning);
  border-radius: var(--radius-md);
}

.action-text + .action-text {
  margin-top: 10rpx;
}
