/* share-card 组件样式 */
.share-card-container {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.share-card-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
}

.share-card-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 90vw;
}

.card-preview {
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.4);
}

.share-canvas {
  display: block;
  background: #111827;
}

.card-actions {
  margin-top: 32rpx;
  width: 100%;
  text-align: center;
}

.card-info {
  margin-bottom: 20rpx;
}

.card-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
}

.card-hint {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

.card-buttons {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.btn-save,
.btn-share {
  padding: 16rpx 40rpx;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
}

.btn-save {
  background: rgba(255, 255, 255, 0.15);
  color: #ffffff;
}

.btn-share {
  background: #6366f1;
  color: #ffffff;
}
