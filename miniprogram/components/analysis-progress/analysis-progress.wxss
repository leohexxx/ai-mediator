.analysis-progress { padding: 30rpx 26rpx; background: var(--color-card); border-top: 7rpx solid var(--color-brand); border-bottom: 1rpx solid var(--color-border); }
.progress-kicker { color: var(--color-brand); font-size: 18rpx; font-weight: 700; letter-spacing: 4rpx; }
.progress-message { margin-top: 10rpx; color: var(--color-text-primary); font-size: 30rpx; font-weight: 800; }
.progress-row { display: flex; align-items: center; gap: 14rpx; margin-top: 20rpx; }
.progress-track { flex: 1; height: 8rpx; background: var(--color-border); overflow: hidden; }
.progress-fill { height: 100%; background: var(--color-brand); transition: width .3s ease; }
.progress-percent { width: 68rpx; text-align: right; color: var(--color-brand); font-size: 20rpx; font-weight: 700; }
.step-list { display: flex; justify-content: space-between; gap: 6rpx; margin-top: 26rpx; }
.step-item { flex: 1; color: var(--color-text-muted); }
.step-index { width: 26rpx; height: 26rpx; display: flex; align-items: center; justify-content: center; color: var(--color-text-muted); border: 1rpx solid var(--color-border); font-size: 15rpx; }
.step-label { margin-top: 8rpx; font-size: 17rpx; line-height: 1.35; }
.step-item.done .step-index { color: #fff; background: var(--color-brand); border-color: var(--color-brand); }
.step-item.active { color: var(--color-text-primary); font-weight: 700; }
.step-item.active .step-index { color: #fff; background: var(--color-warning); border-color: var(--color-warning); }
.progress-note { margin-top: 22rpx; padding-top: 16rpx; color: var(--color-text-muted); border-top: 1rpx solid var(--color-border); font-size: 18rpx; line-height: 1.5; }
