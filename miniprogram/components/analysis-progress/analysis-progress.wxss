/* 分析进度组件样式 */
.analysis-progress {
  margin-bottom: 24rpx;
}

.progress-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.progress-icon {
  font-size: 44rpx;
  margin-right: 16rpx;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.progress-info {
  flex: 1;
}

.progress-message {
  font-size: var(--font-md);
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}

.progress-bar-wrapper {
  display: flex;
  align-items: center;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: var(--color-border);
  border-radius: var(--radius-full);
  overflow: hidden;
  margin-right: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-brand), var(--color-party-b));
  border-radius: var(--radius-full);
  transition: width 0.5s ease;
}

.progress-percent {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  min-width: 56rpx;
  text-align: right;
}

.step-list {
  display: flex;
  overflow-x: auto;
  padding: 8rpx 0;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  min-width: 80rpx;
  flex-shrink: 0;
}

.step-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xs);
  color: var(--color-text-muted);
  transition: var(--transition-fast);
}

.step-item.done .step-dot {
  background: var(--color-success);
  border-color: var(--color-success);
  color: #fff;
}

.step-item.active .step-dot {
  background: var(--color-brand);
  border-color: var(--color-brand);
  color: #fff;
  box-shadow: 0 0 16rpx rgba(99, 102, 241, 0.4);
}

.step-label {
  font-size: 18rpx;
  color: var(--color-text-muted);
  margin-top: 8rpx;
  white-space: nowrap;
}

.step-item.done .step-label,
.step-item.active .step-label {
  color: var(--color-text-primary);
}

.step-line {
  position: absolute;
  top: 22rpx;
  left: calc(50% + 22rpx);
  width: calc(100% - 44rpx);
  height: 2rpx;
  background: var(--color-border);
  z-index: -1;
}

.step-item.done .step-line {
  background: var(--color-success);
}
