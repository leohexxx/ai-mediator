/* 详细分析组件样式 */
.detailed-analysis {
  margin-bottom: 24rpx;
}

.analysis-summary {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.summary-title {
  font-size: var(--font-sm);
  font-weight: var(--font-medium);
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.summary-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.tab-bar {
  display: flex;
  border-bottom: 1rpx solid var(--color-border);
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  border-bottom: 2rpx solid transparent;
  transition: var(--transition-fast);
}

.tab-item.active {
  color: var(--color-brand);
  border-bottom-color: var(--color-brand);
}

.tab-content {
  padding-top: 8rpx;
}

/* 人物画像 */
.character-card {
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.02);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
}

.char-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.char-role {
  font-size: var(--font-xs);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
  margin-right: 12rpx;
}

.char-role.role-a { background: rgba(99,102,241,.15); color: var(--color-party-a); }
.char-role.role-b { background: rgba(236,72,153,.15); color: var(--color-party-b); }
.char-role.role-other { background: rgba(107,114,128,.15); color: var(--color-text-muted); }

.char-name {
  font-size: var(--font-md);
  font-weight: var(--font-medium);
  color: var(--color-text-primary);
}

.char-attr {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.attr-label {
  color: var(--color-text-muted);
}

/* 争议焦点 */
.conflict-card {
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: rgba(255,255,255,.02);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
}

.conflict-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.conflict-topic {
  font-size: var(--font-md);
  font-weight: var(--font-medium);
  color: var(--color-text-primary);
}

.conflict-severity { font-size: var(--font-xs); }
.conflict-stance { margin-bottom: 12rpx; }
.stance-a, .stance-b { font-size: var(--font-sm); color: var(--color-text-secondary); margin-bottom: 4rpx; }

.judgment-winner {
  font-size: var(--font-sm);
  font-weight: var(--font-medium);
  margin-bottom: 4rpx;
}
.judgment-winner.a { color: var(--color-party-a); }
.judgment-winner.b { color: var(--color-party-b); }
.judgment-winner.tie { color: var(--color-warning); }

.judgment-text { font-size: var(--font-sm); color: var(--color-text-secondary); line-height: 1.6; }

/* 时间线 */
.tl-item { display: flex; padding-bottom: 0; }
.tl-marker {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 16rpx;
  width: 32rpx;
  flex-shrink: 0;
}

.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-border);
  flex-shrink: 0;
}
.tl-dot.turning-point { background: var(--color-warning); box-shadow: 0 0 8rpx rgba(245,158,11,.4); }

.tl-line { width: 2rpx; flex: 1; min-height: 24rpx; background: var(--color-border); }

.tl-content { flex: 1; padding-bottom: 24rpx; }
.tl-item:last-child .tl-content { padding-bottom: 0; }

.tl-time { font-size: var(--font-xs); margin-bottom: 4rpx; }
.tl-speaker { font-size: var(--font-sm); margin-bottom: 4rpx; }
.tl-role { font-weight: var(--font-medium); color: var(--color-text-primary); }
.tl-role.turning { color: var(--color-warning); }
.tl-emotion { margin-left: 8rpx; color: var(--color-text-muted); }

.tl-desc { font-size: var(--font-sm); color: var(--color-text-secondary); line-height: 1.6; }
.tl-significance { font-size: var(--font-xs); margin-top: 4rpx; }
.tl-turning { font-size: var(--font-xs); color: var(--color-warning); font-weight: var(--font-medium); margin-top: 4rpx; }
