<!-- 详细分析 Tab 区 -->
<view class="detailed-analysis card" wx:if="{{detailedAnalysis}}">
  <!-- 案情摘要 -->
  <view class="analysis-summary" wx:if="{{summary}}">
    <view class="summary-title">📝 案情摘要</view>
    <view class="summary-text">{{summary}}</view>
  </view>

  <!-- Tab 切换 -->
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="onTabTap"
    >
      {{item.label}}
    </view>
  </view>

  <!-- Tab 内容：人物画像 -->
  <view class="tab-content" wx:if="{{activeTab === 'characters'}}">
    <view wx:for="{{characters}}" wx:key="name" class="character-card">
      <view class="char-header">
        <view class="char-role {{item.role === 'party_a' ? 'role-a' : item.role === 'party_b' ? 'role-b' : 'role-other'}}">
          {{item.role === 'party_a' ? '甲方' : item.role === 'party_b' ? '乙方' : '其他'}}
        </view>
        <view class="char-name">{{item.name}}</view>
      </view>
      <view class="char-attr"><text class="attr-label">性格：</text>{{item.personality}}</view>
      <view class="char-attr"><text class="attr-label">立场：</text>{{item.stance}}</view>
      <view class="char-attr"><text class="attr-label">情绪：</text>{{item.emotionalState}}</view>
      <view class="char-attr"><text class="attr-label">沟通风格：</text>{{item.communicationStyle}}</view>
    </view>
  </view>

  <!-- Tab 内容：争议焦点 -->
  <view class="tab-content" wx:if="{{activeTab === 'conflicts'}}">
    <view wx:for="{{conflicts}}" wx:key="topic" class="conflict-card">
      <view class="conflict-header">
        <view class="conflict-topic">{{item.topic}}</view>
        <view class="conflict-severity {{item.severity}}">
          {{item.severity === 'high' ? '🔴严重' : item.severity === 'medium' ? '🟡中等' : '🟢轻微'}}
        </view>
      </view>
      <view class="conflict-stance">
        <view class="stance-a">甲方: {{item.partyAStance}}</view>
        <view class="stance-b">乙方: {{item.partyBStance}}</view>
      </view>
      <view class="conflict-judgment">
        <view class="judgment-winner {{item.winner}}">
          {{item.winner === 'a' ? '→ 甲方更有理' : item.winner === 'b' ? '→ 乙方更有理' : '→ 双方各有道理'}}
        </view>
        <view class="judgment-text">{{item.aiJudgment}}</view>
      </view>
    </view>
  </view>

  <!-- Tab 内容：时间线 -->
  <view class="tab-content" wx:if="{{activeTab === 'timeline'}}">
    <view wx:for="{{timeline}}" wx:key="timestamp" class="tl-item">
      <view class="tl-marker">
        <view class="tl-dot {{item.isTurningPoint ? 'turning-point' : ''}}"></view>
        <view class="tl-line" wx:if="{{index < timeline.length - 1}}"></view>
      </view>
      <view class="tl-content">
        <view class="tl-time text-muted">{{item.timestamp}}</view>
        <view class="tl-speaker">
          <text class="tl-role {{item.isTurningPoint ? 'turning' : ''}}">{{item.speaker}}</text>
          <text class="tl-emotion">{{item.emotion}}</text>
        </view>
        <view class="tl-desc">{{item.content}}</view>
        <view class="tl-significance text-secondary" wx:if="{{item.significance}}">{{item.significance}}</view>
        <view class="tl-turning" wx:if="{{item.isTurningPoint}}">⚡ 转折点</view>
      </view>
    </view>
  </view>
</view>
