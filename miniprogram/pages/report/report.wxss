/* 分析报告页样式 */

/* 补充内容标记 */
.supplement-banner {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  background: #FFF8E1;
  border-radius: var(--radius-md);
  border: 1rpx solid #FFE082;
}

.supplement-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.supplement-text {
  font-size: var(--font-xs);
  color: #F57F17;
  line-height: 1.5;
}

.restricted-banner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--color-warning);
}

/* AI 免责声明 */
.ai-disclaimer {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin: 16rpx 0;
  padding: 16rpx 20rpx;
  background: rgba(234, 179, 8, 0.08);
  border: 1rpx solid rgba(234, 179, 8, 0.2);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.6;
}

.ai-disclaimer-icon {
  font-size: 24rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.restricted-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}

.restricted-text {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.6;
}

.layer-header {
  display: flex;
  align-items: center;
  padding: 48rpx 0 24rpx;
}

.layer-line {
  flex: 1;
  height: 1rpx;
  background: var(--color-border);
}

.layer-title {
  padding: 0 24rpx;
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  letter-spacing: 4rpx;
}

/* ===== 分享按钮栏 ===== */
.share-bar {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0;
}

.share-btn {
  flex: 1;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  border-radius: 12rpx;
  background: var(--color-brand);
  color: #ffffff;
  border: none;
}

.share-btn.secondary {
  background: rgba(99, 102, 241, 0.1);
  color: var(--color-brand);
  border: 1rpx solid rgba(99, 102, 241, 0.2);
}

/* ===== 分享面板 ===== */
.share-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.share-panel {
  width: 100%;
  background: var(--color-card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.share-panel-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 32rpx;
}

.share-templates {
  display: flex;
  gap: 24rpx;
  justify-content: center;
  margin-bottom: 40rpx;
}

.share-template-item {
  width: 180rpx;
}

.template-preview {
  width: 180rpx;
  height: 240rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.verdict-preview {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
}

.fun-preview {
  background: linear-gradient(135deg, #f59e0b, #ef4444);
}

.suspense-preview {
  background: linear-gradient(135deg, #111827, #374151);
}

.template-score {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.template-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
}

.template-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.share-panel-close {
  text-align: center;
  padding: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-muted);
}

/* ===== 空状态中的分析按钮 ===== */
.analyze-btn {
  margin-top: 24rpx;
  min-width: 200rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.empty-desc {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 8rpx;
}

/* ===== 性格信息展示 ===== */
.personality-display {
  margin: 24rpx 0;
  padding: 24rpx;
  background: rgba(139, 92, 246, 0.06);
  border: 1rpx solid rgba(139, 92, 246, 0.15);
  border-radius: 16rpx;
}

.personality-empty {
  margin: 24rpx 0;
  padding: 24rpx;
  background: rgba(99, 102, 241, 0.05);
  border: 1rpx dashed rgba(99, 102, 241, 0.2);
  border-radius: 16rpx;
  text-align: center;
}

.personality-empty-text {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-bottom: 16rpx;
}

.personality-add-btn,
.personality-edit-btn {
  display: inline-block;
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  color: #8b5cf6;
  border: 1rpx solid rgba(139, 92, 246, 0.3);
  border-radius: 24rpx;
}

.personality-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.personality-row:last-of-type {
  margin-bottom: 16rpx;
}

.personality-tag {
  font-size: 22rpx;
  color: #8b5cf6;
  background: rgba(139, 92, 246, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 14rpx;
}

.personality-text {
  font-size: 26rpx;
  color: var(--color-text-primary);
}

/* ===== 性格编辑器弹窗 ===== */
.personality-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.personality-modal {
  width: 90vw;
  max-height: 85vh;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.modal-close {
  font-size: 36rpx;
  color: var(--color-text-muted);
  padding: 8rpx;
}

.modal-scroll {
  flex: 1;
  max-height: 55vh;
  margin-bottom: 24rpx;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.btn-cancel {
  flex: 1;
  padding: 20rpx 32rpx;
  text-align: center;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  background: var(--color-bg-tertiary);
  color: var(--color-text-secondary);
}

.btn-reanalyze {
  flex: 2;
  padding: 20rpx 32rpx;
  text-align: center;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  background: #8b5cf6;
  color: #ffffff;
}

.stuck-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}
.stuck-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.stuck-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ef4444;
  margin-bottom: 12rpx;
}
.stuck-desc {
  font-size: 28rpx;
  color: #9ca3af;
  margin-bottom: 40rpx;
}
.retry-btn {
  width: 400rpx;
}

/* ===== 补充内容按钮 ===== */
.supplement-evidence-bar {
  margin: 16rpx 0;
}

.supplement-btn {
  width: 100%;
  padding: 20rpx 32rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  background: rgba(99, 102, 241, 0.08);
  color: var(--color-brand);
  border: 1rpx dashed rgba(99, 102, 241, 0.3);
}

