/* 分析报告页样式 */
.restricted-banner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--color-warning);
}

.restricted-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}

.restricted-text {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.6;
}

.layer-header {
  display: flex;
  align-items: center;
  padding: 48rpx 0 24rpx;
}

.layer-line {
  flex: 1;
  height: 1rpx;
  background: var(--color-border);
}

.layer-title {
  padding: 0 24rpx;
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  letter-spacing: 4rpx;
}

/* ===== 分享按钮栏 ===== */
.share-bar {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0;
}

.share-btn {
  flex: 1;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  border-radius: 12rpx;
  background: var(--color-brand);
  color: #ffffff;
  border: none;
}

.share-btn.secondary {
  background: rgba(99, 102, 241, 0.1);
  color: var(--color-brand);
  border: 1rpx solid rgba(99, 102, 241, 0.2);
}

/* ===== 分享面板 ===== */
.share-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.share-panel {
  width: 100%;
  background: var(--color-card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.share-panel-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 32rpx;
}

.share-templates {
  display: flex;
  gap: 24rpx;
  justify-content: center;
  margin-bottom: 40rpx;
}

.share-template-item {
  width: 180rpx;
}

.template-preview {
  width: 180rpx;
  height: 240rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.verdict-preview {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
}

.fun-preview {
  background: linear-gradient(135deg, #f59e0b, #ef4444);
}

.suspense-preview {
  background: linear-gradient(135deg, #111827, #374151);
}

.template-score {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.template-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
}

.template-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.share-panel-close {
  text-align: center;
  padding: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-muted);
}

/* ===== 空状态中的分析按钮 ===== */
.analyze-btn {
  margin-top: 24rpx;
  min-width: 200rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.empty-desc {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 8rpx;
}
