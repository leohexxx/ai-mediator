.report-masthead { position: relative; margin: 12rpx 0 20rpx; padding: 40rpx 34rpx 28rpx; overflow: hidden; background: var(--color-card); border: 1rpx solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
.report-masthead::after { content: ''; position: absolute; right: -100rpx; bottom: -150rpx; width: 320rpx; height: 320rpx; border: 1rpx solid rgba(194,160,90,.16); border-radius: 50%; }
.report-kicker { position: relative; z-index: 1; color: var(--color-accent); font-size: 17rpx; letter-spacing: 3rpx; }
.report-title-row { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; }
.report-title { color: var(--color-text-primary); font-family: 'Songti SC','STSong','SimSun',serif; font-size: 52rpx; font-weight: 700; line-height: 1.2; }
.report-subtitle { margin-top: 7rpx; color: var(--color-text-muted); font-size: 22rpx; }
.report-ai-seal { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; margin-left: 20rpx; color: #29252A; background: var(--color-accent); border-radius: 50%; font-size: 26rpx; font-weight: 800; transform: rotate(-7deg); box-shadow: 0 14rpx 34rpx rgba(9,8,12,.26); }
.report-parties { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; margin-top: 32rpx; padding-top: 18rpx; color: var(--color-text-secondary); border-top: 1rpx solid var(--color-border); font-size: 20rpx; }
.report-vs { color: var(--color-brand-light); font-size: 16rpx; letter-spacing: 3rpx; }

.cancel-analysis-bar { margin: 20rpx 0; padding: 24rpx; background: var(--color-warning-bg); border: 1rpx solid rgba(194,160,90,.38); border-radius: var(--radius-md); }
.lock-copy { margin-bottom: 15rpx; color: var(--color-warning); font-size: 21rpx; line-height: 1.6; letter-spacing: 1rpx; }
.btn-cancel-analysis { width: 100%; min-height: 78rpx; color: #F8F3EC; background: var(--color-error); border-radius: var(--radius-md); font-size: 24rpx; }
.revision-note,.single-evidence-note { display: flex; align-items: center; margin: 14rpx 0; padding: 15rpx 18rpx; color: var(--color-text-secondary); background: rgba(255,255,255,.035); border-left: 3rpx solid var(--color-accent); font-size: 20rpx; letter-spacing: 1rpx; }
.single-evidence-note { color: var(--color-warning); background: var(--color-warning-bg); border-left-color: var(--color-warning); }

.supplement-banner { display: flex; align-items: center; margin-bottom: 16rpx; padding: 17rpx 20rpx; color: var(--color-text-secondary); background: rgba(169,79,96,.09); border: 1rpx solid rgba(201,120,136,.28); border-radius: var(--radius-md); }
.supplement-icon { flex-shrink: 0; margin-right: 14rpx; color: var(--color-brand-light); font-size: 17rpx; font-weight: 700; letter-spacing: 2rpx; }
.supplement-text { font-size: 22rpx; line-height: 1.5; }
.restricted-banner { display: flex; flex-direction: column; align-items: center; padding: 80rpx 48rpx; background: var(--color-card); border: 1rpx solid var(--color-warning); border-radius: var(--radius-lg); }
.restricted-icon { margin-bottom: 24rpx; color: var(--color-warning); font-size: 48rpx; }
.restricted-text { color: var(--color-text-secondary); font-size: var(--font-md); line-height: 1.6; text-align: center; }
.ai-disclaimer { display: flex; align-items: flex-start; gap: 10rpx; margin: 18rpx 0; padding: 18rpx 20rpx; color: var(--color-text-muted); background: var(--color-warning-bg); border: 1rpx solid rgba(194,160,90,.22); border-radius: var(--radius-sm); font-size: 21rpx; line-height: 1.65; }
.ai-disclaimer-icon { flex-shrink: 0; margin-top: 2rpx; color: var(--color-accent); font-size: 24rpx; }

.layer-header { display: flex; align-items: center; padding: 56rpx 0 25rpx; }
.layer-line { flex: 1; height: 1rpx; background: var(--color-border); }
.layer-title { padding: 0 22rpx; color: var(--color-text-muted); font-size: 20rpx; letter-spacing: 2rpx; }
.share-bar { display: flex; gap: 14rpx; margin: 26rpx 0 16rpx; }
.share-btn { flex: 1; min-height: 82rpx; padding: 16rpx 20rpx; color: #F8F3EC; background: var(--color-brand); border: none; border-radius: var(--radius-md); font-size: 24rpx; font-weight: 600; }
.share-btn.secondary { color: var(--color-text-secondary); background: transparent; border: 1rpx solid var(--color-border-light); }
.supplement-evidence-bar { margin: 14rpx 0 4rpx; }
.supplement-btn { width: 100%; min-height: 82rpx; color: var(--color-brand-light); background: rgba(169,79,96,.07); border: 1rpx dashed rgba(201,120,136,.4); border-radius: var(--radius-md); font-size: 24rpx; }

.personality-display,.personality-empty,.communication-insights { margin: 22rpx 0; padding: 24rpx; background: rgba(255,255,255,.035); border: 1rpx solid var(--color-border); border-radius: var(--radius-md); }
.personality-empty { border-style: dashed; text-align: center; }
.personality-empty-text { margin-bottom: 16rpx; color: var(--color-text-muted); font-size: 23rpx; }
.personality-add-btn,.personality-edit-btn { display: inline-block; padding: 9rpx 22rpx; color: var(--color-brand-light); border-bottom: 1rpx solid rgba(201,120,136,.5); font-size: 22rpx; }
.personality-row { display: flex; align-items: center; margin-bottom: 12rpx; }
.personality-row:last-of-type { margin-bottom: 16rpx; }
.personality-tag { margin-right: 14rpx; padding: 4rpx 12rpx; color: var(--color-accent); background: var(--color-warning-bg); border-radius: var(--radius-sm); font-size: 20rpx; }
.personality-text { color: var(--color-text-primary); font-size: 25rpx; }
.communication-insights { border-left: 3rpx solid var(--color-accent); }
.communication-title { color: var(--color-accent); font-size: 19rpx; font-weight: 700; letter-spacing: 1rpx; }
.communication-disclaimer,.communication-summary,.communication-suggestion { margin-top: 12rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 1.65; }

.share-overlay,.personality-overlay { position: fixed; inset: 0; z-index: var(--z-modal); display: flex; align-items: flex-end; background: rgba(18,17,23,.86); }
.share-panel { width: 100%; padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #24222C; border-top: 1rpx solid var(--color-border-light); border-radius: 24rpx 24rpx 0 0; }
.share-panel-title { margin-bottom: 30rpx; color: var(--color-text-primary); font-family: 'Songti SC','STSong','SimSun',serif; font-size: 32rpx; font-weight: 700; text-align: center; }
.share-templates { display: flex; gap: 18rpx; justify-content: center; margin-bottom: 32rpx; }
.share-template-item { width: 190rpx; }
.template-preview { width: 190rpx; height: 236rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; margin-bottom: 12rpx; border: 1rpx solid var(--color-border-light); border-radius: var(--radius-md); }
.verdict-preview { background: #7F3544; }
.fun-preview { background: #68735E; }
.suspense-preview { background: #24222C; }
.template-score,.template-text { color: var(--color-text-primary); font-family: Georgia,'Songti SC',serif; font-size: 27rpx; font-weight: 700; }
.template-label { color: var(--color-text-secondary); font-size: 21rpx; text-align: center; }
.share-panel-close { padding: 16rpx; color: var(--color-text-muted); font-size: 26rpx; text-align: center; }

.personality-overlay { align-items: center; justify-content: center; padding: 28rpx; box-sizing: border-box; }
.personality-modal { width: 100%; max-height: 86vh; padding: 36rpx 30rpx 30rpx; display: flex; flex-direction: column; box-sizing: border-box; background: #24222C; border: 1rpx solid var(--color-border-light); border-radius: var(--radius-lg); }
.modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.modal-title { color: var(--color-text-primary); font-family: 'Songti SC','STSong','SimSun',serif; font-size: 34rpx; font-weight: 700; }
.modal-close { padding: 8rpx; color: var(--color-text-muted); font-size: 32rpx; }
.modal-scroll { flex: 1; max-height: 56vh; margin-bottom: 24rpx; }
.modal-actions { display: flex; gap: 14rpx; }
.btn-cancel,.btn-reanalyze { min-height: 80rpx; padding: 18rpx 26rpx; border-radius: var(--radius-md); font-size: 25rpx; }
.btn-cancel { flex: 1; color: var(--color-text-secondary); background: transparent; border: 1rpx solid var(--color-border-light); }
.btn-reanalyze { flex: 2; color: #F8F3EC; background: var(--color-brand); }

.stuck-section { display: flex; flex-direction: column; align-items: center; padding: 60rpx 40rpx; text-align: center; }
.stuck-icon { margin-bottom: 18rpx; color: var(--color-error); font-size: 18rpx; font-weight: 700; letter-spacing: 4rpx; }
.stuck-title { margin-bottom: 12rpx; color: var(--color-text-primary); font-family: 'Songti SC','STSong','SimSun',serif; font-size: 36rpx; font-weight: 700; }
.stuck-desc { margin-bottom: 36rpx; color: var(--color-text-muted); font-size: 25rpx; }
.retry-btn { width: 400rpx; }
.analyze-btn { min-width: 220rpx; margin-top: 24rpx; }
.empty-icon { margin-bottom: 16rpx; color: var(--color-accent); font-size: 54rpx; }
.empty-title { color: var(--color-text-secondary); font-size: 28rpx; }
.empty-desc { margin-top: 8rpx; color: var(--color-text-muted); font-size: 23rpx; }
