/* 分析报告页样式 */

/* V3 report shell */
.report-page { padding-top: 30rpx; }
.report-meta { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; padding: 24rpx 6rpx; border-bottom: 1rpx solid var(--color-border); }
.meta-kicker { color: var(--color-brand); font-size: 18rpx; font-weight: 700; letter-spacing: 3rpx; }
.meta-title { margin-top: 7rpx; color: var(--color-text-primary); font-size: 32rpx; font-weight: 800; }
.meta-badge { flex-shrink: 0; padding: 7rpx 10rpx; color: var(--color-brand); border: 1rpx solid var(--color-brand); font-size: 18rpx; }
.single-evidence-note, .revision-note { padding: 17rpx 20rpx; color: #FFE4A4; background: var(--color-warning-bg); border-left: 5rpx solid var(--color-warning); font-size: 21rpx; line-height: 1.55; }
.revision-note { color: #FFD8E0; background: rgba(255, 77, 106, .13); border-left-color: var(--color-brand); }
.ai-disclaimer { margin: 22rpx 0; padding: 20rpx; color: var(--color-text-secondary); background: var(--color-bg-secondary); border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); font-size: 20rpx; line-height: 1.65; }
.knowledge-panel { margin: 22rpx 0; padding: 22rpx; background: var(--color-card); border: 1rpx solid var(--color-border); }
.knowledge-title { color: var(--color-text-primary); font-size: 23rpx; font-weight: 700; }
.knowledge-item { margin-top: 9rpx; color: var(--color-text-muted); font-size: 20rpx; }
.report-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 24rpx 0 42rpx; }
.report-actions button { margin: 0; border-radius: 0; font-size: 22rpx; }
.report-actions .supplement-btn { width: 100%; color: #fff; background: var(--color-brand); box-shadow: 0 8rpx 20rpx rgba(255, 77, 106, .28); }
.report-actions .share-btn { flex: 1; color: var(--color-brand); background: transparent; border: 1rpx solid var(--color-brand); }
.report-actions .share-btn::after, .btn-cancel-analysis::after { border: 0; }
.layer-header { display: flex; align-items: baseline; gap: 14rpx; margin: 48rpx 0 20rpx; padding-bottom: 12rpx; border-bottom: 1rpx solid var(--color-border); }
.layer-no { color: var(--color-brand); font-size: 20rpx; font-weight: 800; }
.layer-title { color: var(--color-text-primary); font-size: 29rpx; font-weight: 800; }
.cancel-analysis-bar { margin-top: 14rpx; padding: 22rpx; color: var(--color-text-secondary); background: var(--color-card); border: 1rpx solid var(--color-border); }
.lock-copy { margin-bottom: 14rpx; font-size: 21rpx; line-height: 1.55; }
.btn-cancel-analysis { width: 100%; border-radius: 0; color: var(--color-error); background: transparent; border: 1rpx solid var(--color-error); font-size: 23rpx; }
.stuck-section { padding: 34rpx 24rpx; background: var(--color-card); border-top: 7rpx solid var(--color-warning); }
.stuck-code { color: var(--color-warning); font-size: 18rpx; font-weight: 700; letter-spacing: 4rpx; }
.stuck-title { margin-top: 10rpx; font-size: 32rpx; font-weight: 800; }
.stuck-desc { margin-top: 12rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 1.65; }

/* 补充内容标记 */
.supplement-banner {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  background: #FFF8E1;
  border-radius: var(--radius-md);
  border: 1rpx solid #FFE082;
}

.supplement-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.supplement-text {
  font-size: var(--font-xs);
  color: #F57F17;
  line-height: 1.5;
}

.restricted-banner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--color-warning);
}

/* AI 免责声明 */
.ai-disclaimer {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin: 16rpx 0;
  padding: 16rpx 20rpx;
  background: rgba(234, 179, 8, 0.08);
  border: 1rpx solid rgba(234, 179, 8, 0.2);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.6;
}

.ai-disclaimer-icon {
  font-size: 24rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.restricted-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}

.restricted-text {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.6;
}

.layer-header {
  display: flex;
  align-items: center;
  padding: 48rpx 0 24rpx;
}

.layer-line {
  flex: 1;
  height: 1rpx;
  background: var(--color-border);
}

.layer-title {
  padding: 0 24rpx;
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  letter-spacing: 4rpx;
}

/* ===== 分享按钮栏 ===== */
.share-bar {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0;
}

.share-btn {
  flex: 1;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  border-radius: 12rpx;
  background: var(--color-brand);
  color: #ffffff;
  border: none;
}

.share-btn.secondary {
  background: var(--color-success-bg);
  color: var(--color-brand);
  border: 1rpx solid rgba(40, 122, 101, 0.28);
}

/* ===== 分享面板 ===== */
.share-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.share-panel {
  width: 100%;
  background: var(--color-card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.share-panel-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 32rpx;
}

.share-templates {
  display: flex;
  gap: 24rpx;
  justify-content: center;
  margin-bottom: 40rpx;
}

.share-template-item {
  width: 180rpx;
}

.template-preview {
  width: 180rpx;
  height: 240rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.verdict-preview { background: linear-gradient(135deg, #FF4D6A, #A855F7); }

.fun-preview {
  background: linear-gradient(135deg, #f59e0b, #ef4444);
}

.suspense-preview { background: linear-gradient(135deg, #1A1033, #3B285F); }

.template-score {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.template-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
}

.template-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.share-panel-close {
  text-align: center;
  padding: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-muted);
}

/* ===== 空状态中的分析按钮 ===== */
.analyze-btn {
  margin-top: 24rpx;
  min-width: 200rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.empty-desc {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 8rpx;
}

/* ===== 性格信息展示 ===== */
.personality-display {
  margin: 24rpx 0;
  padding: 24rpx;
  background: var(--color-success-bg);
  border: 1rpx solid rgba(40, 122, 101, 0.22);
  border-radius: 16rpx;
}

.personality-empty {
  margin: 24rpx 0;
  padding: 24rpx;
  background: var(--color-bg-secondary);
  border: 1rpx dashed rgba(40, 122, 101, 0.28);
  border-radius: 16rpx;
  text-align: center;
}

.personality-empty-text {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-bottom: 16rpx;
}

.personality-add-btn,
.personality-edit-btn {
  display: inline-block;
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  color: var(--color-brand);
  border: 1rpx solid rgba(40, 122, 101, 0.35);
  border-radius: 24rpx;
}

.personality-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.personality-row:last-of-type {
  margin-bottom: 16rpx;
}

.personality-tag {
  font-size: 22rpx;
  color: var(--color-brand);
  background: var(--color-success-bg);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 14rpx;
}

.personality-text {
  font-size: 26rpx;
  color: var(--color-text-primary);
}

/* ===== 性格编辑器弹窗 ===== */
.personality-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.personality-modal {
  width: 90vw;
  max-height: 85vh;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.modal-close {
  font-size: 36rpx;
  color: var(--color-text-muted);
  padding: 8rpx;
}

.modal-scroll {
  flex: 1;
  max-height: 55vh;
  margin-bottom: 24rpx;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.btn-cancel {
  flex: 1;
  padding: 20rpx 32rpx;
  text-align: center;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  background: var(--color-bg-tertiary);
  color: var(--color-text-secondary);
}

.btn-reanalyze {
  flex: 2;
  padding: 20rpx 32rpx;
  text-align: center;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  background: var(--color-brand);
  color: #ffffff;
}

.stuck-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}
.stuck-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.stuck-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ef4444;
  margin-bottom: 12rpx;
}
.stuck-desc {
  font-size: 28rpx;
  color: #9ca3af;
  margin-bottom: 40rpx;
}
.retry-btn {
  width: 400rpx;
}

/* ===== 补充内容按钮 ===== */
.supplement-evidence-bar {
  margin: 16rpx 0;
}

.supplement-btn {
  width: 100%;
  padding: 20rpx 32rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  background: var(--color-success-bg);
  color: var(--color-brand);
  border: 1rpx dashed rgba(40, 122, 101, 0.35);
}

.cancel-analysis-bar {
  margin: 20rpx 0;
}

.btn-cancel-analysis {
  color: #b45309;
  background: #fffbeb;
  border: 1rpx solid #f59e0b;
}
.evidence-version-banner {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fff7e8;
  color: #8a5a00;
  font-size: 24rpx;
}

/* V3 final overrides (placed last to win over legacy report styles). */
.report-page .ai-disclaimer { margin: 22rpx 0; padding: 20rpx; color: var(--color-text-secondary); background: var(--color-bg-secondary); border: 1rpx solid var(--color-border); border-left: 5rpx solid var(--color-brand); border-radius: 0; font-size: 20rpx; line-height: 1.65; }
.report-page .layer-header { display: flex; align-items: baseline; justify-content: flex-start; gap: 14rpx; margin: 48rpx 0 20rpx; padding: 0 0 12rpx; border-bottom: 1rpx solid var(--color-border); }
.report-page .layer-title { padding: 0; color: var(--color-text-primary); background: transparent; font-size: 29rpx; font-weight: 800; }
.report-page .stuck-section { display: block; padding: 34rpx 24rpx; text-align: left; background: var(--color-card); border-top: 7rpx solid var(--color-warning); }
.report-page .stuck-title { margin: 10rpx 0 0; color: var(--color-text-primary); font-size: 32rpx; font-weight: 800; }
.report-page .stuck-desc { margin: 12rpx 0 24rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 1.65; }
.report-page .retry-btn { width: 100%; border-radius: 0; }
.report-page .report-actions .supplement-btn { width: 100%; padding: 20rpx; color: #fff; background: var(--color-brand); border: 0; border-radius: 0; }
.report-page .cancel-analysis-bar { margin: 14rpx 0 20rpx; padding: 22rpx; color: var(--color-text-secondary); background: var(--color-card); border: 1rpx solid var(--color-border); }
.report-page .btn-cancel-analysis { width: 100%; color: var(--color-error); background: transparent; border: 1rpx solid var(--color-error); border-radius: 0; }

/* V3 沟通偏好资料：暖色编辑风，明确其非证据属性。 */
.report-page .personality-panel { margin: 22rpx 0; padding: 24rpx; background: var(--color-card); border: 1rpx solid var(--color-border); border-top: 6rpx solid var(--color-warning); }
.report-page .personality-panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.report-page .panel-kicker { color: var(--color-warning); font-size: 18rpx; font-weight: 700; letter-spacing: 1rpx; }
.report-page .personality-panel-title { margin-top: 6rpx; color: var(--color-text-primary); font-size: 30rpx; font-weight: 800; }
.report-page .personality-panel-desc { margin: 16rpx 0 18rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 1.65; }
.report-page .personality-edit-btn { margin: 0; padding: 10rpx 14rpx; color: var(--color-brand); background: transparent; border: 1rpx solid var(--color-brand); border-radius: 0; font-size: 21rpx; line-height: 1.4; }
.report-page .personality-row { display: flex; align-items: center; margin-top: 10rpx; }
.report-page .personality-tag { min-width: 76rpx; margin-right: 14rpx; padding: 4rpx 10rpx; color: #fff; background: var(--color-text-primary); border-radius: 0; font-size: 20rpx; text-align: center; }
.report-page .personality-text { color: var(--color-text-primary); font-size: 24rpx; }
.report-page .personality-empty { padding: 16rpx; color: var(--color-text-muted); background: var(--color-bg-secondary); font-size: 22rpx; line-height: 1.6; }
.report-page .personality-modal { border-radius: 0; border-top: 8rpx solid var(--color-warning); }
.report-page .modal-desc { margin-top: 8rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 1.5; }
.report-page .modal-close { color: var(--color-brand); font-size: 22rpx; }
.report-page .btn-reanalyze { background: var(--color-brand); border-radius: 0; }

/* V3.2：证据结论与沟通画像分层展示。 */
.report-page .meta-badge.perspective { color: #E9D6FF; border-color: var(--color-accent); }
.report-page .communication-insights { margin: 22rpx 0; padding: 24rpx; background: rgba(168, 85, 247, .15); border: 1rpx solid rgba(192, 132, 252, .42); border-left: 6rpx solid var(--color-accent); }
.report-page .communication-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.report-page .communication-mode { color: #E9D6FF; font-size: 19rpx; font-weight: 700; }
.report-page .communication-title { margin-top: 8rpx; color: var(--color-text-primary); font-size: 30rpx; font-weight: 800; }
.report-page .communication-disclaimer { margin-top: 14rpx; color: #E9D6FF; font-size: 20rpx; line-height: 1.6; }
.report-page .communication-summary { margin-top: 18rpx; color: var(--color-text-primary); font-size: 24rpx; line-height: 1.65; }
.report-page .communication-item, .report-page .communication-pattern { margin-top: 12rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 1.6; }
.report-page .communication-item text { display: inline-block; min-width: 74rpx; margin-right: 12rpx; color: #fff; background: var(--color-accent); font-size: 19rpx; text-align: center; }
.report-page .communication-suggestion { margin-top: 12rpx; padding-top: 12rpx; color: var(--color-text-primary); border-top: 1rpx solid rgba(192, 132, 252, .35); font-size: 22rpx; line-height: 1.6; }
.report-page .communication-empty { margin-top: 16rpx; padding: 16rpx; color: var(--color-text-secondary); background: rgba(255,255,255,.46); font-size: 22rpx; line-height: 1.6; }
