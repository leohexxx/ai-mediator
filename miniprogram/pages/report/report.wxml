<!-- 分析报告页 (v3) — 性格信息 + 重新分析 -->

<view class="container" wx:if="{{!loading}}">

  <!-- 分析进度 -->
  <analysis-progress wx:if="{{progress && progress.step !== 'done' && !progressStuck}}" progress="{{progress}}" />

  <!-- 分析卡住时显示重试 -->
  <view class="stuck-section" wx:if="{{progressStuck}}">
    <view class="stuck-icon">⏰</view>
    <view class="stuck-title">分析似乎卡住了</view>
    <view class="stuck-desc">可能是网络波动或服务器繁忙，请重试</view>
    <button class="btn-primary retry-btn" bindtap="onRetryAnalyze">重新分析</button>
  </view>

  <!-- 隐私限制 -->
  <view class="restricted-banner" wx:if="{{restricted}}">
    <view class="restricted-icon">&#x1F512;</view>
    <view class="restricted-text">{{restrictedMessage}}</view>
  </view>

  <!-- 报告内容（仅分析完成时展示，分析中只显示进度条，避免渲染半成品/旧缓存） -->
  <view wx:if="{{analysis && !restricted && progress && progress.step === 'done'}}">
    <core-verdict coreConclusion="{{analysis.coreConclusion}}" />

    <!-- AI 免责声明 (合规新增) -->
    <view class="ai-disclaimer">
      <view class="ai-disclaimer-icon">&#x2139;</view>
      <text>本报告由 AI 自动生成，仅供参考，不构成法律或心理建议。</text>
    </view>

    <!-- 性格信息展示 + 编辑入口 (v3 新增) -->
    <view class="personality-display" wx:if="{{personalityA || personalityB}}">
      <view class="personality-row" wx:if="{{personalityA}}">
        <text class="personality-tag">关于你</text>
        <text class="personality-text">{{personalityA.mbti || ''}} {{personalityA.zodiac || ''}} {{personalityA.element || ''}}</text>
      </view>
      <view class="personality-row" wx:if="{{personalityB}}">
        <text class="personality-tag">关于对方</text>
        <text class="personality-text">{{personalityB.mbti || ''}} {{personalityB.zodiac || ''}} {{personalityB.element || ''}}</text>
      </view>
      <view class="personality-edit-btn" bindtap="onEditPersonality">编辑性格信息</view>
    </view>

    <view class="personality-empty" wx:elif="{{analysis && analysis.coreConclusion}}">
      <view class="personality-empty-text">补充性格信息，让分析结合 MBTI 和星座维度</view>
      <view class="personality-add-btn" bindtap="onEditPersonality">添加性格信息</view>
    </view>

    <!-- 分享按钮 -->
    <view class="share-bar">
      <button class="share-btn" open-type="share">分享给好友</button>
      <button class="share-btn secondary" bindtap="onOpenShare">生成分享卡片</button>
    </view>

    <!-- ═══ 第二层：证据 & 情绪 ═══ -->
    <view class="layer-header">
      <view class="layer-line"></view>
      <text class="layer-title">证据 & 情绪</text>
      <view class="layer-line"></view>
    </view>
    <evidence-weights items="{{analysis.evidenceWeights || []}}" />
    <emotion-curve curves="{{analysis.emotionCurve || []}}" />

    <!-- ═══ 第三层：调解策略 ═══ -->
    <view class="layer-header">
      <view class="layer-line"></view>
      <text class="layer-title">调解策略</text>
      <view class="layer-line"></view>
    </view>
    <mediation-strategy steps="{{analysis.mediationStrategy || []}}" />

    <!-- ═══ 第四层：详细分析 ═══ -->
    <view class="layer-header">
      <view class="layer-line"></view>
      <text class="layer-title">详细分析</text>
      <view class="layer-line"></view>
    </view>
    <detailed-analysis detailedAnalysis="{{analysis.detailedAnalysis}}" activeTab="{{activeTab}}" bind:tabchange="onTabChange" />

    <!-- 追问 (暂保留，P2 启用) -->
    <chat-panel caseId="{{caseId}}" analysis="{{analysis}}" />
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!analysis && !progress}}">
    <view class="empty-icon">&#x1F4CA;</view>
    <view class="empty-title">暂无分析数据</view>
    <view class="empty-desc">上传聊天记录后即可开始分析</view>
    <button class="btn-primary analyze-btn" bindtap="onManualAnalyze">开始分析</button>
  </view>

  <view class="safe-bottom"></view>
</view>

<!-- 分享面板 (v2 新增) -->
<view class="share-overlay" wx:if="{{showSharePanel}}" bindtap="onCloseShare">
  <view class="share-panel" catchtap="">
    <view class="share-panel-title">选择分享卡片样式</view>
    
    <view class="share-templates">
      <view class="share-template-item" data-template="verdict" bindtap="onSelectShareTemplate">
        <view class="template-preview verdict-preview">
          <view class="template-score">65 : 35</view>
          <view class="template-label">裁决版</view>
        </view>
      </view>
      <view class="share-template-item" data-template="fun" bindtap="onSelectShareTemplate">
        <view class="template-preview fun-preview">
          <view class="template-text">谁更有理?</view>
          <view class="template-label">趣味版</view>
        </view>
      </view>
      <view class="share-template-item" data-template="suspense" bindtap="onSelectShareTemplate">
        <view class="template-preview suspense-preview">
          <view class="template-text">???</view>
          <view class="template-label">悬念版</view>
        </view>
      </view>
    </view>

    <view class="share-panel-close" bindtap="onCloseShare">取消</view>
  </view>
</view>

<!-- 性格信息编辑器弹窗 -->
<view class="personality-overlay" wx:if="{{showPersonalityEditor}}">
  <view class="personality-modal">
    <view class="modal-header">
      <text class="modal-title">编辑性格信息</text>
      <view class="modal-close" bindtap="onClosePersonalityEditor">&#x2715;</view>
    </view>

    <scroll-view class="modal-scroll" scroll-y>
      <personality-picker
        id="reportPersonalityPicker"
        show-hint="{{false}}"
        party-a-label="你的性格"
        party-b-label="对方的性格"
        personality-a="{{personalityA}}"
        personality-b="{{personalityB}}"
      />
    </scroll-view>

    <view class="modal-actions">
      <button class="btn-cancel" bindtap="onClosePersonalityEditor">取消</button>
      <button class="btn-reanalyze" bindtap="onSavePersonality" loading="{{reanalyzing}}">
        {{reanalyzing ? '分析中...' : '保存并重新分析'}}
      </button>
    </view>
  </view>
</view>

<!-- 加载中 -->
<view class="loading-spinner" wx:if="{{loading}}">
  <text>加载报告中...</text>
</view>

<!-- 分享卡片 (Canvas 2D 绘制) -->
<share-card id="shareCard" />
