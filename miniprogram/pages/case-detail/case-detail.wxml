<!-- 案例详情页 -->
<view class="container" wx:if="{{!loading && !showJoinPrompt}}">
  <!-- 案例标题 -->
  <view class="case-header">
    <view class="case-title">{{caseData.title}}</view>
    <view class="case-meta text-secondary">
      关系：{{caseData.relationship || '未设置'}} | 创建于 {{caseData.createdAt}}
    </view>
  </view>

  <!-- 双人状态面板 -->
  <party-status
    caseData="{{caseData}}"
    role="{{role}}"
    statusLabel="{{statusLabel}}"
    otherPartyLabel="{{otherPartyLabel}}"
  />

  <!-- 己方聊天记录操作区 -->
  <evidence-section
    caseData="{{caseData}}"
    role="{{role}}"
    myEvidence="{{myEvidence}}"
    bind:upload="onUploadTap"
    bind:viewreport="onViewReportTap"
  />

  <!-- 邀请面板（甲方可见） -->
  <invite-panel
    wx:if="{{role === 'party_a' && showInvitePanel}}"
    invitation="{{invitation}}"
    caseTitle="{{caseData.title}}"
    bind:toggle="onToggleInvitePanel"
    bind:share="onInvitePanelShare"
  />

  <!-- 邀请区（未展开时） -->
  <view class="invite-toggle" wx:if="{{role === 'party_a' && !showInvitePanel && caseData.status === 'waiting_party_b'}}">
    <view class="btn-secondary" bindtap="onToggleInvitePanel">
      邀请对方加入
    </view>
  </view>

  <!-- 分析状态提示 -->
  <view class="analysis-hint card" wx:if="{{caseData.status === 'waiting_submission' && !myEvidence}}">
    <view class="hint-icon">01</view>
    <view class="hint-text">请上传你们的聊天记录</view>
    <view class="hint-sub">任意一方提交自己的有效证据后即可启动分析</view>
  </view>

  <view class="analysis-hint card" wx:if="{{caseData.status === 'waiting_submission' && myEvidence}}">
    <view class="hint-icon">02</view>
    <view class="hint-text">已上传，可以开始分析</view>
    <view class="hint-sub">仅有单方证据时，报告会明确标注并降低置信度</view>
  </view>

  <view class="analysis-hint card" wx:if="{{caseData.status === 'dual_collecting' || caseData.status === 'canceled'}}">
    <view class="hint-icon">03</view>
    <view class="hint-text">双方可以继续补充证据</view>
    <view class="hint-sub">提交后任意有证据的一方都可启动新一轮分析</view>
  </view>

  <view class="analysis-hint card" wx:if="{{caseData.status === 'analyzing' || caseData.status === 'cancel_requested'}}">
    <view class="hint-icon">AI</view>
    <view class="hint-text">{{caseData.status === 'cancel_requested' ? '正在打断分析...' : 'AI 正在分析中...'}}</view>
    <view class="hint-sub">分析期间双方证据均已锁定，可在报告页打断</view>
  </view>

  <!-- 分析完成 -->
  <view class="analysis-complete card" wx:if="{{caseData.status === 'completed' && analysis}}">
    <view class="complete-header">
      <view class="complete-icon">OK</view>
      <view class="complete-text">分析完成</view>
    </view>

    <!-- 隐私受限提示 -->
    <view wx:if="{{analysis.restricted}}">
      <view class="restricted-text">{{analysis.restrictedMessage}}</view>
    </view>

    <!-- 正常报告入口 -->
    <view wx:else>
      <view class="btn-primary report-btn" bindtap="onViewReportTap">
        查看完整报告 →
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>

<!-- 加载中 -->
<view class="loading-spinner" wx:if="{{loading}}">
  <text class="text-secondary">加载中...</text>
</view>

<!-- 加入案例提示（乙方通过邀请码首次打开） -->
<view class="join-prompt" wx:if="{{showJoinPrompt}}">
  <view class="join-card card">
    <view class="join-icon">02</view>
    <view class="join-title">你被邀请加入双人案例</view>
    <view class="join-desc">你可以独立补充自己的证据，双方都能发起或打断分析。</view>
    <view class="join-error" wx:if="{{joinError}}">{{joinError}}</view>
    <view class="join-actions">
      <button class="btn-primary" bindtap="onJoinCase" loading="{{joining}}" disabled="{{joining}}">
        {{joining ? '加入中...' : '接受邀请，一起看看'}}
      </button>
    </view>
  </view>
</view>
