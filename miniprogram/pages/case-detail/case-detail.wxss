/* 案例详情页样式 */
.case-header {
  margin-bottom: 32rpx;
}

.collaboration-cast { display: flex; align-items: center; width: 190rpx; height: 64rpx; margin-bottom: 12rpx; }
.cast-avatar { width: 64rpx; height: 64rpx; }
.cast-referee { width: 54rpx; height: 54rpx; margin: 0 -2rpx; z-index: 2; }

.case-title {
  font-size: var(--font-2xl);
  font-weight: var(--font-bold);
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.case-meta {
  font-size: var(--font-sm);
}

.invite-toggle {
  margin: 24rpx 0;
  text-align: center;
}

.invite-toggle .btn-secondary {
  display: block;
}

.analysis-hint {
  text-align: center;
  margin-top: 24rpx;
  border: 1rpx solid rgba(192, 132, 252, .3);
  box-shadow: var(--shadow-sm);
}

.hint-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.hint-text {
  font-size: var(--font-lg);
  font-weight: var(--font-medium);
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.hint-sub {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
}

.analysis-complete {
  margin-top: 24rpx;
}

.complete-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.complete-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.complete-text {
  font-size: var(--font-lg);
  font-weight: var(--font-semibold);
  color: var(--color-success);
}

.restricted-text {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  text-align: center;
  padding: 32rpx 0;
}

.report-btn {
  display: block;
  margin-top: 16rpx;
}

/* 加入案例提示 */
.join-prompt {
  padding: 40rpx 24rpx;
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.join-card {
  text-align: center;
  padding: 60rpx 40rpx;
  max-width: 500rpx;
}
.join-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.join-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}
.join-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  margin-bottom: 24rpx;
}
.join-error {
  font-size: 24rpx;
  color: var(--color-error, #ef4444);
  margin-bottom: 16rpx;
}
.join-actions {
  margin-top: 16rpx;
}
