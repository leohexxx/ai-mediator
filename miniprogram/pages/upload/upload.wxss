/* 上传聊天记录页样式 */
.role-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  background: rgba(99, 102, 241, 0.15);
  border-radius: var(--radius-full);
  font-size: var(--font-sm);
  color: var(--color-brand);
  margin-bottom: 32rpx;
}

.upload-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 0;
}

.upload-card {
  width: 100%;
  padding: 32rpx 24rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  text-align: center;
  transition: var(--transition-fast);
  margin-bottom: 0;
  box-sizing: border-box;
}

.upload-card.active {
  border-color: var(--color-brand);
  background: rgba(99, 102, 241, 0.08);
}

.upload-card:last-child {
  margin-top: 16rpx;
  flex: none;
  width: 100%;
}

.upload-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.upload-title {
  font-size: var(--font-md);
  font-weight: var(--font-medium);
  color: var(--color-text-primary);
  margin-bottom: 6rpx;
}

.upload-desc {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
  line-height: 1.5;
}

.upload-file-name {
  font-size: var(--font-sm);
  margin-top: 8rpx;
}

.or-divider {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
}

.or-line {
  flex: 1;
  height: 1rpx;
  background: var(--color-border);
}

.or-text {
  padding: 0 24rpx;
  font-size: var(--font-sm);
}

.text-input-area {
  margin-bottom: 24rpx;
}

.text-input {
  width: 100%;
  min-height: 300rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: var(--font-sm);
  color: var(--color-text-primary);
  line-height: 1.8;
  font-family: monospace;
  box-sizing: border-box;
}

.input-placeholder {
  color: var(--color-text-muted);
}

.text-count {
  text-align: right;
  font-size: var(--font-xs);
  margin-top: 8rpx;
}

.note-section {
  margin-bottom: 24rpx;
}

.note-label {
  font-size: var(--font-md);
  font-weight: var(--font-medium);
  color: var(--color-text-primary);
  margin-bottom: 4rpx;
}

.note-desc {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  margin-bottom: 12rpx;
}

.note-input {
  width: 100%;
  min-height: 120rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: var(--font-sm);
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.submit-area {
  padding: 16rpx 0;
}

.submit-area .btn-primary {
  width: 100%;
}

/* ===== 性格信息弹窗 ===== */
.personality-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.personality-modal {
  width: 90vw;
  max-height: 80vh;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 8rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: var(--color-text-muted);
  text-align: center;
  margin-bottom: 24rpx;
}

.modal-scroll {
  flex: 1;
  max-height: 50vh;
  margin-bottom: 24rpx;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.deep-mode-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  margin: 16rpx 0;
  background: var(--color-bg-tertiary);
  border-radius: 20rpx;
}

.deep-mode-info {
  flex: 1;
  padding-right: 20rpx;
}

.deep-mode-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.deep-mode-desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  line-height: 1.4;
}

.btn-skip {
  flex: 1;
  padding: 20rpx 32rpx;
  text-align: center;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  background: var(--color-bg-tertiary);
  color: var(--color-text-secondary);
}

.btn-confirm {
  flex: 2;
  padding: 20rpx 32rpx;
  text-align: center;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  background: var(--color-brand);
  color: #ffffff;
}

/* 推荐卡片（截图置顶高亮） */
.upload-card-recommend {
  border-color: var(--color-brand);
  border-width: 2rpx;
  position: relative;
}
.upload-card-recommend::before {
  content: '推荐';
  position: absolute;
  top: -10rpx;
  right: 20rpx;
  background: var(--color-brand);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 继续添加按钮 */
.add-more-row {
  text-align: center;
  margin-top: -8rpx;
  margin-bottom: 8rpx;
}
.btn-add-more {
  display: inline-block;
  padding: 12rpx 32rpx;
  border: 1rpx dashed var(--color-brand);
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: var(--color-brand);
  background: transparent;
}

/* 证据工作台：保留原上传流程，只强化层级与状态。 */
.evidence-workbench-head { display: flex; align-items: center; gap: 18rpx; margin: 10rpx 0 28rpx; padding: 22rpx; background: linear-gradient(135deg, rgba(255, 77, 106, .15), rgba(96, 165, 250, .10)); border: 1rpx solid rgba(255, 128, 148, .35); border-radius: var(--radius-lg); }
.workbench-icon { width: 76rpx; height: 76rpx; flex-shrink: 0; }
.workbench-copy { min-width: 0; }
.workbench-kicker { color: var(--color-warning); font-size: 18rpx; font-weight: 800; letter-spacing: 2rpx; }
.workbench-title { margin-top: 5rpx; color: var(--color-text-primary); font-size: 29rpx; font-weight: 800; }
.workbench-desc { margin-top: 5rpx; color: var(--color-text-muted); font-size: 20rpx; line-height: 1.45; }
.upload-options { gap: 14rpx; }
.upload-card { box-shadow: var(--shadow-sm); }
.upload-card-recommend { box-shadow: 0 12rpx 30rpx rgba(255, 77, 106, .16); }
.upload-icon { width: 50rpx; height: 50rpx; font-size: 0; }
.add-more-row { margin: -3rpx 0 5rpx; }
.btn-add-more { background: rgba(96, 165, 250, .10); border-color: var(--color-info); color: #B7D7FF; }
.note-section { border: 1rpx solid var(--color-border); box-shadow: var(--shadow-sm); }
