.evidence-workbench-head { position: relative; display: flex; align-items: flex-start; margin: 10rpx 0 46rpx; padding: 0 0 36rpx; border-bottom: 1rpx solid var(--color-border); }
.workbench-number { width: 86rpx; padding-top: 6rpx; color: var(--color-accent); font-family: Georgia,serif; font-size: 26rpx; letter-spacing: 3rpx; }
.workbench-copy { flex: 1; }
.workbench-kicker { color: var(--color-accent); font-size: 18rpx; letter-spacing: 4rpx; }
.workbench-title { margin-top: 7rpx; color: var(--color-text-primary); font-family: 'Songti SC','STSong','SimSun',serif; font-size: 50rpx; font-weight: 700; line-height: 1.2; }
.workbench-desc { margin-top: 14rpx; color: var(--color-text-muted); font-size: 23rpx; line-height: 1.7; }

.supplement-badge,.role-badge { margin-bottom: 22rpx; padding: 16rpx 20rpx; color: var(--color-text-secondary); background: rgba(255,255,255,.035); border-left: 4rpx solid var(--color-accent); font-size: 21rpx; letter-spacing: 1rpx; }
.supplement-badge { border-left-color: var(--color-brand-light); }
.upload-options { display: flex; flex-direction: column; gap: 14rpx; }
.upload-card { position: relative; min-height: 154rpx; padding: 26rpx 28rpx; box-sizing: border-box; overflow: hidden; background: rgba(255,255,255,.035); border: 1rpx solid var(--color-border); border-radius: var(--radius-md); transition: transform var(--transition-normal), border-color var(--transition-normal), background var(--transition-normal); }
.upload-card:active { transform: scale(.985); background: var(--color-card-hover); }
.upload-card.active { background: rgba(169,79,96,.11); border-color: rgba(201,120,136,.58); }
.upload-card-recommend { min-height: 184rpx; padding-top: 28rpx; border-color: rgba(194,160,90,.28); }
.upload-card-recommend::after { content: '首选'; position: absolute; top: 0; right: 0; padding: 7rpx 17rpx; color: #29252A; background: var(--color-accent); border-radius: 0 0 0 12rpx; font-size: 18rpx; font-weight: 700; }
.upload-index { margin-bottom: 8rpx; color: var(--color-accent); font-family: Georgia,serif; font-size: 18rpx; letter-spacing: 3rpx; }
.upload-title { color: var(--color-text-primary); font-size: 30rpx; font-weight: 650; }
.upload-desc { max-width: 560rpx; margin-top: 6rpx; color: var(--color-text-muted); font-size: 22rpx; line-height: 1.55; }
.upload-file-name { margin-top: 14rpx; font-size: 22rpx; font-weight: 600; }
.upload-error { margin-top: 13rpx; color: var(--color-error); font-size: 20rpx; line-height: 1.55; word-break: break-all; }
.add-more-row { padding: 2rpx 0 8rpx; }
.btn-add-more { display: flex; align-items: center; justify-content: center; min-height: 76rpx; color: var(--color-brand-light); background: rgba(169,79,96,.08); border: 1rpx dashed rgba(201,120,136,.45); border-radius: var(--radius-md); font-size: 23rpx; }
.btn-add-more:active { background: rgba(169,79,96,.16); }

.text-input-area,.note-section { margin-top: 34rpx; }
.text-input-area { position: relative; }
.text-input,.note-input { width: 100%; min-height: 240rpx; padding: 26rpx; box-sizing: border-box; color: var(--color-text-primary); background: rgba(255,255,255,.035); border: 1rpx solid var(--color-border); border-radius: var(--radius-md); font-size: 25rpx; line-height: 1.7; }
.text-input:focus,.note-input:focus { border-color: rgba(194,160,90,.6); }
.note-input { min-height: 160rpx; margin-top: 15rpx; }
.input-placeholder { color: var(--color-text-muted); }
.text-count { margin-top: 8rpx; text-align: right; font-size: 19rpx; }
.note-label { color: var(--color-accent); font-size: 19rpx; letter-spacing: 2rpx; }
.note-desc { margin-top: 5rpx; color: var(--color-text-secondary); font-size: 25rpx; }
.submit-area { margin-top: 32rpx; }
.submit-area .btn-primary { width: 100%; }

.personality-overlay { position: fixed; inset: 0; z-index: var(--z-modal); display: flex; align-items: flex-end; background: rgba(18,17,23,.86); }
.personality-modal { width: 100%; max-height: 90vh; padding: 40rpx 34rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #24222C; border: 1rpx solid var(--color-border-light); border-radius: 24rpx 24rpx 0 0; box-shadow: var(--shadow-lg); }
.modal-title { color: var(--color-text-primary); font-family: 'Songti SC','STSong','SimSun',serif; font-size: 39rpx; font-weight: 700; }
.modal-subtitle { margin-top: 8rpx; color: var(--color-text-muted); font-size: 22rpx; }
.modal-scroll { max-height: 50vh; margin-top: 24rpx; }
.deep-mode-row { display: flex; align-items: center; gap: 20rpx; margin-top: 24rpx; padding: 22rpx 0; border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); }
.deep-mode-info { flex: 1; }
.deep-mode-title { color: var(--color-text-primary); font-size: 27rpx; font-weight: 600; }
.deep-mode-desc { margin-top: 4rpx; color: var(--color-text-muted); font-size: 20rpx; line-height: 1.5; }
.modal-actions { display: flex; gap: 14rpx; margin-top: 28rpx; }
.btn-skip,.btn-confirm { min-height: 84rpx; border-radius: var(--radius-md); font-size: 25rpx; }
.btn-skip { flex: .7; color: var(--color-text-secondary); background: transparent; border: 1rpx solid var(--color-border-light); }
.btn-confirm { flex: 1.5; color: #F8F3EC; background: var(--color-brand); }
