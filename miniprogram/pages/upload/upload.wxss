.upload-page { padding-top: 42rpx; }
.page-heading { padding: 0 10rpx 34rpx 22rpx; }
.heading-kicker, .section-kicker, .modal-kicker { color: var(--color-brand); font-size: 19rpx; font-weight: 700; letter-spacing: 4rpx; }
.heading-title { margin-top: 10rpx; color: var(--color-text-primary); font-size: 48rpx; line-height: 1.2; font-weight: 800; }
.heading-desc { margin-top: 18rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 1.7; }
.role-row { display: flex; justify-content: space-between; padding: 18rpx 22rpx; margin-bottom: 24rpx; border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); font-size: 22rpx; }
.role-label { color: var(--color-text-muted); }
.role-value { color: var(--color-text-primary); font-weight: 700; }

.upload-options { display: flex; flex-direction: column; }
.upload-card { display: flex; align-items: flex-start; gap: 18rpx; padding: 26rpx 18rpx; border-bottom: 1rpx solid var(--color-border); background: transparent; }
.upload-card:first-child { border-top: 1rpx solid var(--color-border); }
.upload-card:active, .upload-card.active { background: var(--color-bg-secondary); }
.upload-card.primary { border-left: 6rpx solid var(--color-brand); }
.upload-code { width: 48rpx; flex-shrink: 0; color: var(--color-warning); font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.upload-copy { flex: 1; min-width: 0; }
.upload-title { color: var(--color-text-primary); font-size: 28rpx; font-weight: 700; }
.upload-desc { margin-top: 7rpx; color: var(--color-text-muted); font-size: 21rpx; line-height: 1.55; }
.upload-status { margin-top: 10rpx; color: var(--color-brand); font-size: 21rpx; font-weight: 700; }
.upload-action { flex-shrink: 0; margin-top: 4rpx; padding-bottom: 3rpx; color: var(--color-brand); border-bottom: 1rpx solid var(--color-brand); font-size: 21rpx; }
.batch-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 22rpx; background: #EDF5F1; border-bottom: 1rpx solid #BCD8CE; }
.batch-count { color: var(--color-brand); font-size: 36rpx; font-weight: 800; line-height: 1; }
.batch-label { margin-top: 5rpx; color: var(--color-text-secondary); font-size: 19rpx; }
.add-more { margin: 0; border-radius: 0; color: #fff; background: var(--color-brand); font-size: 23rpx; }
.add-more::after, .ocr-review::after, .btn-quick::after, .btn-deep::after { border: 0; }

.review-section, .note-section { margin-top: 42rpx; padding: 28rpx 22rpx; background: var(--color-card); border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); }
.review-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 12rpx; }
.section-title { margin-top: 6rpx; color: var(--color-text-primary); font-size: 31rpx; font-weight: 800; }
.ocr-review { margin: 0; border-radius: 0; color: #fff; background: var(--color-warning); font-size: 21rpx; }
.ocr-review.confirmed { background: var(--color-brand); }
.quality-warning { margin-top: 20rpx; padding: 16rpx; color: #794C17; background: #F8EBD7; border-left: 5rpx solid var(--color-warning); font-size: 21rpx; line-height: 1.55; }
.text-input { width: 100%; min-height: 300rpx; margin-top: 20rpx; padding: 22rpx; box-sizing: border-box; color: var(--color-text-primary); background: var(--color-bg); border: 1rpx solid var(--color-border); border-radius: 0; font-family: 'Microsoft YaHei', sans-serif; font-size: 23rpx; line-height: 1.75; }
.input-placeholder { color: var(--color-text-muted); }
.text-count { margin-top: 10rpx; text-align: right; color: var(--color-text-muted); font-size: 19rpx; }
.note-desc { margin-top: 14rpx; color: var(--color-text-muted); font-size: 21rpx; line-height: 1.6; }
.note-input { width: 100%; min-height: 130rpx; margin-top: 16rpx; padding: 20rpx; box-sizing: border-box; color: var(--color-text-primary); background: var(--color-bg); border: 1rpx solid var(--color-border); border-radius: 0; font-size: 23rpx; }
.submit-area { padding: 30rpx 0 12rpx; }
.submit-area .btn-primary { width: 100%; border-radius: 0; background: var(--color-text-primary); }
.submit-note { margin-top: 14rpx; color: var(--color-text-muted); font-size: 20rpx; line-height: 1.55; }

.analysis-mode-overlay { position: fixed; inset: 0; z-index: 400; display: flex; align-items: flex-end; background: rgba(32, 40, 36, .58); }
.analysis-mode-modal { width: 100%; padding: 38rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: var(--color-bg); border-top: 8rpx solid var(--color-brand); }
.modal-title { margin-top: 10rpx; color: var(--color-text-primary); font-size: 36rpx; font-weight: 800; }
.modal-subtitle { margin-top: 12rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 1.65; }
.analysis-step { margin-top: 28rpx; color: var(--color-text-primary); font-size: 23rpx; font-weight: 800; }
.analysis-step text { display: inline-block; width: 36rpx; margin-right: 8rpx; color: var(--color-warning); font-size: 18rpx; letter-spacing: 1rpx; }
.perspective-options { display: flex; flex-direction: column; gap: 12rpx; margin-top: 14rpx; }
.perspective-option { padding: 22rpx 20rpx; background: var(--color-card); border: 1rpx solid var(--color-border); border-left: 5rpx solid transparent; }
.perspective-option.selected { border-color: var(--color-brand); border-left-color: var(--color-brand); background: #EDF5F1; }
.perspective-option.selected.communication { border-color: var(--color-warning); border-left-color: var(--color-warning); background: #F8EBD7; }
.preference-wrap { margin-top: 16rpx; padding: 18rpx; background: var(--color-card); border-top: 4rpx solid var(--color-warning); }
.preference-head { color: var(--color-text-primary); font-size: 25rpx; font-weight: 800; }
.preference-desc { margin-top: 8rpx; color: var(--color-text-secondary); font-size: 20rpx; line-height: 1.55; }
.mode-comparison { display: flex; gap: 14rpx; margin-top: 14rpx; }
.analysis-option { flex: 1; min-height: 128rpx; padding: 20rpx; box-sizing: border-box; background: var(--color-card); border: 1rpx solid var(--color-border); }
.deep-option { border-top: 4rpx solid var(--color-warning); }
.option-name { font-size: 27rpx; font-weight: 700; }
.option-desc { margin-top: 10rpx; color: var(--color-text-secondary); font-size: 20rpx; line-height: 1.55; }
.option-meta { margin-top: 12rpx; color: var(--color-brand); font-size: 19rpx; font-weight: 700; }
.modal-actions { display: flex; gap: 14rpx; margin-top: 24rpx; }
.btn-quick, .btn-deep { flex: 1; border-radius: 0; font-size: 25rpx; }
.btn-quick { color: var(--color-text-primary); background: transparent; border: 1rpx solid var(--color-text-primary); }
.btn-deep { color: #fff; background: var(--color-text-primary); }
