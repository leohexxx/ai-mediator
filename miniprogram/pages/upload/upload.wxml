<!-- V3 证据上传：批次追加、OCR校对、分析方式分离 -->
<view class="container upload-page">
  <view class="page-heading">
    <view class="heading-kicker">EVIDENCE / {{supplement ? 'SUPPLEMENT' : 'NEW'}}</view>
    <view class="heading-title">{{supplement ? '补充一版证据' : '添加聊天证据'}}</view>
    <view class="heading-desc">每次最多选择 9 张，可反复追加到同一批次。图片先去重和 OCR，确认文字后才会保存为证据。</view>
  </view>

  <view class="role-row">
    <text class="role-label">当前提交方</text>
    <text class="role-value">{{role === 'party_a' ? '发起方' : '受邀方'}}</text>
  </view>

  <view class="upload-options">
    <view class="upload-card primary {{uploadMode === 'album' ? 'active' : ''}}" bindtap="onChooseMedia">
      <view class="upload-code">01</view>
      <view class="upload-copy">
        <view class="upload-title">选择聊天截图</view>
        <view class="upload-desc">推荐使用连续截图；系统会过滤完全重复和近似重复图片。</view>
        <view class="upload-status" wx:if="{{uploadMode === 'album' && ocrProcessing}}">正在识别 {{ocrProgress.current}} / {{ocrProgress.total}}</view>
        <view class="upload-status" wx:if="{{uploadMode === 'album' && !ocrProcessing && selectedImageCount > 0}}">本批已接受 {{selectedImageCount}} 张</view>
      </view>
      <view class="upload-action">选择</view>
    </view>

    <view class="batch-toolbar" wx:if="{{uploadMode === 'album' && !ocrProcessing && selectedImageCount > 0}}">
      <view>
        <view class="batch-count">{{selectedImageCount}}</view>
        <view class="batch-label">已接受图片</view>
      </view>
      <button class="add-more" bindtap="onContinueChooseMedia">继续添加下一批</button>
    </view>

    <view class="upload-card {{uploadMode === 'video' ? 'active' : ''}}" bindtap="onChooseVideo">
      <view class="upload-code">02</view>
      <view class="upload-copy">
        <view class="upload-title">聊天录屏</view>
        <view class="upload-desc">适合很长的记录；系统抽取关键帧后识别，仍需人工校对。</view>
        <view class="upload-status" wx:if="{{uploadMode === 'video' && ocrProcessing}}">正在处理视频...</view>
        <view class="upload-status" wx:if="{{uploadMode === 'video' && !ocrProcessing && selectedImageCount > 0}}">录屏已处理</view>
      </view>
      <view class="upload-action">选择</view>
    </view>

    <view class="upload-card {{uploadMode === 'paste' ? 'active' : ''}}" bindtap="onPasteText">
      <view class="upload-code">03</view>
      <view class="upload-copy">
        <view class="upload-title">粘贴文字</view>
        <view class="upload-desc">适合已整理好的聊天文本，不经过 OCR。</view>
      </view>
      <view class="upload-action">粘贴</view>
    </view>

    <view class="upload-card {{uploadMode === 'choose_file' ? 'active' : ''}}" bindtap="onChooseMessageFile">
      <view class="upload-code">04</view>
      <view class="upload-copy">
        <view class="upload-title">选择 .txt 文件</view>
        <view class="upload-desc">适合从合法来源导出的文本记录。</view>
        <view class="upload-status" wx:if="{{uploadMode === 'choose_file' && selectedFileName}}">{{selectedFileName}}</view>
      </view>
      <view class="upload-action">选择</view>
    </view>
  </view>

  <view class="review-section" wx:if="{{uploadMode}}">
    <view class="review-head">
      <view>
        <view class="section-kicker">REVIEW</view>
        <view class="section-title">确认识别结果</view>
      </view>
      <button wx:if="{{ocrBlocks.length > 0}}" class="ocr-review {{ocrConfirmed ? 'confirmed' : ''}}" bindtap="onOpenOcrPreview">
        {{ocrConfirmed ? '已校对' : '去校对'}} · {{ocrBlocks.length}} 段
      </button>
    </view>
    <view class="quality-warning" wx:if="{{ocrBlocks.length > 0 && !ocrConfirmed}}">低置信度文字和说话人会影响分析；校对完成前不能提交。</view>
    <textarea class="text-input" placeholder="识别或粘贴的聊天文本会显示在这里..." placeholder-class="input-placeholder" value="{{chatText}}" bindinput="onTextInput" auto-height maxlength="-1" />
    <view class="text-count" wx:if="{{chatText}}">{{chatText.length}} 字 · 服务端只选取必要片段进入模型</view>
  </view>

  <view class="note-section">
    <view class="section-kicker">CONTEXT</view>
    <view class="section-title">补充背景</view>
    <view class="note-desc">只写模型从聊天中无法知道、但确实影响理解的背景。不要在这里填写身份证、银行卡或住址。</view>
    <textarea class="note-input" placeholder="例如：双方关系、争议目标、希望解决的具体问题" placeholder-class="input-placeholder" value="{{note}}" bindinput="onNoteInput" auto-height maxlength="1000" />
  </view>

  <view class="submit-area" wx:if="{{chatText}}">
    <button class="btn-primary" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">
      {{submitting ? '正在保存证据...' : '保存本批证据'}}
    </button>
    <view class="submit-note">保存成功后再选择快速或深度分析；双人案件分析期间双方证据都会锁定。</view>
  </view>
  <view class="safe-bottom"></view>
</view>

<view class="analysis-mode-overlay" wx:if="{{showPersonalityModal}}">
  <view class="analysis-mode-modal">
    <view class="modal-kicker">EVIDENCE SAVED</view>
    <view class="modal-title">第 {{evidenceRevision || 1}} 版证据已保存</view>
    <view class="modal-subtitle">先决定本轮从什么角度看问题；再选择分析深度。两项选择彼此独立。</view>

    <view class="analysis-step"><text>01</text> 选择分析视角</view>
    <view class="perspective-options">
      <view class="perspective-option {{analysisPerspective === 'evidence' ? 'selected' : ''}}" data-perspective="evidence" bindtap="onSelectPerspective">
        <view class="option-name">只按证据分析</view>
        <view class="option-desc">只依据聊天记录、OCR 校对和规则事实，整理分歧、缺失信息与下一步。</view>
        <view class="option-meta">默认 · 不使用 MBTI / 星座</view>
      </view>
      <view class="perspective-option {{analysisPerspective === 'communication' ? 'selected communication' : ''}}" data-perspective="communication" bindtap="onSelectPerspective">
        <view class="option-name">证据 + 沟通画像</view>
        <view class="option-desc">保留相同的证据结论，额外结合自愿填写的偏好，生成沟通方式与相处建议。</view>
        <view class="option-meta">仅影响建议表达，不判定事实或责任</view>
      </view>
    </view>

    <view class="preference-wrap" wx:if="{{analysisPerspective === 'communication'}}">
      <view class="preference-head">可选填写 MBTI / 星座</view>
      <view class="preference-desc">资料会进入“沟通画像”部分，用于调整建议的措辞、节奏和沟通渠道。</view>
      <personality-picker id="personalityPicker" personality-a="{{personalityA}}" personality-b="{{personalityB}}" editable-a="{{canEditPersonalityA}}" editable-b="{{canEditPersonalityB}}" party-a-label="{{personalityLabelA}}" party-b-label="{{personalityLabelB}}" hint-text="可选：填写自己认可的沟通偏好" />
    </view>

    <view class="analysis-step"><text>02</text> 选择分析深度</view>
    <view class="mode-comparison">
      <view class="analysis-option">
        <view class="option-name">快速分析</view>
        <view class="option-desc">优先处理主要分歧与下一步，适合日常沟通。</view>
      </view>
      <view class="analysis-option deep-option">
        <view class="option-name">深度分析</view>
        <view class="option-desc">展开更多可能解释，适合长记录和多个争议点。</view>
      </view>
    </view>
    <view class="modal-actions">
      <button class="btn-quick" bindtap="onPersonalitySkip">开始快速分析</button>
      <button class="btn-deep" bindtap="onPersonalityConfirm">开始深度分析</button>
    </view>
  </view>
</view>
