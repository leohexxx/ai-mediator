<!-- 上传证据页 -->
<view class="container">
  <!-- 身份标识 -->
  <view class="role-badge">
    你的身份：{{role === 'party_a' ? '甲方（发起方）' : '乙方（受邀方）'}}
  </view>

  <!-- 上传方式选择 -->
  <view class="upload-options">
    <!-- 方式一：选择聊天记录 -->
    <view class="upload-card {{uploadMode === 'choose_file' ? 'active' : ''}}" bindtap="onChooseMessageFile">
      <view class="upload-icon">📱</view>
      <view class="upload-title">选择聊天记录</view>
      <view class="upload-desc">从微信聊天中导出文本</view>
      <view class="upload-file-name text-brand" wx:if="{{uploadMode === 'choose_file' && selectedFileName}}">
        ✓ {{selectedFileName}}
      </view>
    </view>

    <!-- 方式二：从相册选择 -->
    <view class="upload-card {{uploadMode === 'album' ? 'active' : ''}}" bindtap="onChooseMedia">
      <view class="upload-icon">🖼️</view>
      <view class="upload-title">从相册选择截图</view>
      <view class="upload-desc">支持微信聊天截图（OCR 将在后续版本支持）</view>
      <view class="upload-file-name text-brand" wx:if="{{uploadMode === 'album' && selectedImageCount > 0}}">
        ✓ 已选择 {{selectedImageCount}} 张
      </view>
    </view>
  </view>

  <!-- 分割线 -->
  <view class="or-divider">
    <view class="or-line"></view>
    <text class="or-text text-muted">或</text>
    <view class="or-line"></view>
  </view>

  <!-- 方式三：粘贴文本 -->
  <view class="upload-card {{uploadMode === 'paste' ? 'active' : ''}}" bindtap="onPasteText">
    <view class="upload-icon">📋</view>
    <view class="upload-title">直接粘贴文本</view>
    <view class="upload-desc">复制聊天记录到剪贴板后粘贴</view>
  </view>

  <!-- 文本输入区 -->
  <view class="text-input-area" wx:if="{{uploadMode}}">
    <textarea
      class="text-input"
      placeholder="请在此粘贴聊天记录文本..."
      placeholder-class="input-placeholder"
      value="{{chatText}}"
      bindinput="onTextInput"
      auto-height
      maxlength="-1"
    />
    <view class="text-count text-muted" wx:if="{{chatText}}">
      已输入 {{chatText.length}} 字
    </view>
  </view>

  <!-- 备注 -->
  <view class="note-section">
    <view class="note-label">📝 备注（可选）</view>
    <view class="note-desc">你想补充什么背景信息？</view>
    <textarea
      class="note-input"
      placeholder="如：对话背景、双方关系说明等..."
      placeholder-class="input-placeholder"
      value="{{note}}"
      bindinput="onNoteInput"
      auto-height
      maxlength="500"
    />
  </view>

  <!-- 提交按钮 -->
  <view class="submit-area" wx:if="{{chatText}}">
    <button
      class="btn-primary"
      bindtap="onSubmit"
      loading="{{submitting}}"
      disabled="{{submitting}}"
    >
      {{submitting ? '提交中...' : '提交证据'}}
    </button>
  </view>

  <view class="safe-bottom"></view>
</view>
