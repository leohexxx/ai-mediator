<!-- 上传聊天记录页 -->
<view class="container">
  <!-- 补充内容标识 -->
  <view class="supplement-badge" wx:if="{{supplement}}">
    📎 补充聊天内容 — 重新看看有什么新发现
  </view>

  <!-- 身份标识 -->
  <view class="role-badge" wx:if="{{!supplement}}">
    你的身份：{{role === 'party_a' ? '发起方' : '受邀方'}}
  </view>

  <!-- 上传方式选择 -->
  <view class="upload-options">
    <!-- 方式一：从相册选择截图（最推荐） -->
    <view class="upload-card upload-card-recommend {{uploadMode === 'album' ? 'active' : ''}}" bindtap="onChooseMedia">
      <view class="upload-icon">🖼️</view>
      <view class="upload-title">从相册选择截图</view>
      <view class="upload-desc">最方便！直接选微信聊天截图，自动识别文字</view>
      <view class="upload-desc text-warning" style="font-size:12px;color:#999;margin-top:4px;">
        ⓘ 若文字内容超过1万字，建议提取关键信息以缩短分析时间，您可自由选择是否使用压缩版
      </view>
      <view class="upload-file-name text-brand" wx:if="{{uploadMode === 'album' && ocrProcessing}}">
        🔄 正在识别 {{ocrProgress.current}}/{{ocrProgress.total}}...
      </view>
      <view class="upload-file-name text-brand" wx:if="{{uploadMode === 'album' && !ocrProcessing && selectedImageCount > 0}}">
        ✓ 已识别 {{selectedImageCount}} 张截图
      </view>
    </view>

    <!-- 继续添加（图片超过9张时出现） -->
    <view class="add-more-row" wx:if="{{uploadMode === 'album' && !ocrProcessing && selectedImageCount > 0}}">
      <view class="btn-add-more" bindtap="onContinueChooseMedia">
        + 继续添加截图（已选 {{selectedImageCount}} 张）
      </view>
    </view>

    <!-- 方式二：录屏/视频上传 -->
    <view class="upload-card {{uploadMode === 'video' ? 'active' : ''}}" bindtap="onChooseVideo">
      <view class="upload-icon">🎬</view>
      <view class="upload-title">录屏/视频上传</view>
      <view class="upload-desc">上传聊天录屏，自动识别文字</view>
      <view class="upload-file-name text-brand" wx:if="{{uploadMode === 'video' && ocrProcessing}}">
        🔄 正在处理视频...
      </view>
      <view class="upload-file-name text-brand" wx:if="{{uploadMode === 'video' && !ocrProcessing && selectedImageCount > 0}}">
        ✓ 视频已上传至云端
      </view>
    </view>

    <!-- 方式三：直接粘贴文本（方便快捷） -->
    <view class="upload-card {{uploadMode === 'paste' ? 'active' : ''}}" bindtap="onPasteText">
      <view class="upload-icon">📋</view>
      <view class="upload-title">直接粘贴文本</view>
      <view class="upload-desc">复制聊天记录到剪贴板后粘贴</view>
    </view>

    <!-- 方式四：选择聊天记录文件（高级用户） -->
    <view class="upload-card {{uploadMode === 'choose_file' ? 'active' : ''}}" bindtap="onChooseMessageFile">
      <view class="upload-icon">📱</view>
      <view class="upload-title">从微信导出 .txt 文件</view>
      <view class="upload-desc">微信「我→设置→通用→聊天记录迁移与备份→导出聊天记录」导出 .txt 后在此选择</view>
      <view class="upload-file-name text-brand" wx:if="{{uploadMode === 'choose_file' && selectedFileName}}">
        ✓ {{selectedFileName}}
      </view>
    </view>
  </view>

  <!-- 分割线 -->
  <view class="or-divider">
    <view class="or-line"></view>
    <text class="or-text text-muted">或</text>
    <view class="or-line"></view>
  </view>

  <!-- 方式三：粘贴文本 -->
  <view class="upload-card {{uploadMode === 'paste' ? 'active' : ''}}" bindtap="onPasteText">
    <view class="upload-icon">📋</view>
    <view class="upload-title">直接粘贴文本</view>
    <view class="upload-desc">复制聊天记录到剪贴板后粘贴</view>
  </view>

  <!-- 文本输入区 -->
  <view class="text-input-area" wx:if="{{uploadMode}}">
    <button wx:if="{{ocrBlocks.length > 0}}" class="btn-ocr-preview" bindtap="onOpenOcrPreview">
      {{ocrConfirmed ? '✓ OCR已校对' : '校对OCR结果'}}（{{ocrBlocks.length}}段）
    </button>
    <textarea
      class="text-input"
      placeholder="请在此粘贴聊天记录文本..."
      placeholder-class="input-placeholder"
      value="{{chatText}}"
      bindinput="onTextInput"
      auto-height
      maxlength="-1"
    />
    <view class="text-count text-muted" wx:if="{{chatText}}">
      已输入 {{chatText.length}} 字
    </view>
  </view>

  <!-- 备注 -->
  <view class="note-section">
    <view class="note-label">📝 说说你的想法</view>
    <view class="note-desc">补充背景、看法或想对调解员提出的问题，例如「大家看这个聊天记录有什么问题？」</view>
    <textarea
      class="note-input"
      placeholder="如：对话背景、双方关系说明等..."
      placeholder-class="input-placeholder"
      value="{{note}}"
      bindinput="onNoteInput"
      auto-height
      maxlength="1000"
    />
  </view>

  <!-- 开始分析按钮 -->
  <view class="submit-area" wx:if="{{chatText}}">
    <button
      class="btn-primary"
      bindtap="onSubmit"
      loading="{{submitting}}"
      disabled="{{submitting}}"
    >
      {{submitting ? '处理中...' : '开始分析'}}
    </button>
  </view>

  <view class="safe-bottom"></view>
</view>

<!-- 性格信息弹窗（上传成功后显示） -->
<view class="personality-overlay" wx:if="{{showPersonalityModal}}">
  <view class="personality-modal">
    <view class="modal-title">聊天记录已收到！</view>
    <view class="modal-subtitle">补充你和对方的性格信息，让分析更精准</view>

    <scroll-view class="modal-scroll" scroll-y>
      <personality-picker
        id="personalityPicker"
        hint-text="填写后分析会结合性格维度（可选）"
      />
    </scroll-view>

    <!-- 深度模式开关 -->
    <view class="deep-mode-row" bindtap="onToggleDeepMode">
      <view class="deep-mode-info">
        <view class="deep-mode-title">深度模式</view>
        <view class="deep-mode-desc">使用 Pro 模型，判断与建议更深入，但耗时约 2-3 分钟</view>
      </view>
      <switch checked="{{deepMode}}" bindchange="onToggleDeepMode" color="#FF6B35" />
    </view>

    <view class="modal-actions">
      <button class="btn-skip" bindtap="onPersonalitySkip">跳过</button>
      <button class="btn-confirm" bindtap="onPersonalityConfirm">确认并开始分析</button>
    </view>
  </view>
</view>
