<!-- OCR 预览编辑页 -->
<view class="container">
  <view class="preview-header">
    <view class="preview-title">OCR 校对</view>
    <view class="preview-hint text-muted">共 {{parsedMessages.length}} 条消息。低置信度内容已标出，请同时核对说话人和阅读顺序。</view>
  </view>

  <view class="message-list">
    <view wx:for="{{parsedMessages}}" wx:key="index" class="msg-item {{item.lowConfidence ? 'low-confidence' : ''}}">
      <view class="msg-header">
        <input
          class="speaker-input"
          value="{{item.speaker}}"
          data-index="{{index}}"
          bindinput="onSpeakerEdit"
          maxlength="20"
        />
        <text class="msg-type text-muted" wx:if="{{item.type !== 'text'}}">[{{item.type}}]</text>
        <text class="msg-time text-muted" wx:if="{{item.timestamp}}">{{item.timestamp}}</text>
        <text class="confidence-warning" wx:if="{{item.lowConfidence}}">请校对 {{item.confidence}}%</text>
        <view class="msg-delete" data-index="{{index}}" bindtap="onDeleteMessage">×</view>
      </view>
      <textarea
        class="content-input"
        value="{{item.content}}"
        data-index="{{index}}"
        bindinput="onContentEdit"
        auto-height
        maxlength="-1"
      />
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{parsedMessages.length === 0}}">
      <view class="text">未解析到消息</view>
    </view>
  </view>

  <!-- 确认按钮 -->
  <view class="confirm-area">
    <button class="btn-primary" bindtap="onConfirm" disabled="{{submitting}}">
      确认导入
    </button>
  </view>

  <view class="safe-bottom"></view>
</view>
