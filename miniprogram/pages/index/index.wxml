<!-- 首页 (v2) — 单人模式 CTA + 案例列表 -->
<view class="container">
  
  <!-- Hero CTA 卡片 -->
  <view class="hero-cta card" bindtap="onStartAnalyze">
    <view class="hero-icon">
      <text class="hero-emoji">&#x1F916;</text>
    </view>
    <view class="hero-title">你的聊天记录，谁更有理？</view>
    <view class="hero-desc">粘贴聊天记录或上传截图</view>
    <view class="hero-desc">AI 帮你客观分析，一分钟出结果</view>
    <view class="hero-btn {{creating ? 'hero-btn-loading' : ''}}">
      <text wx:if="{{!creating}}">开始分析</text>
      <text wx:else>创建中...</text>
    </view>
  </view>

  <!-- 案例标题 -->
  <view class="section-header" wx:if="{{!isEmpty}}">
    <text class="section-title">我的案例</text>
    <text class="section-count">{{caseList.length}} 个</text>
  </view>

  <!-- 案例列表 -->
  <view class="case-list" wx:if="{{!isEmpty}}">
    <view 
      class="case-item card"
      wx:for="{{caseList}}"
      wx:key="_id"
      data-id="{{item._id}}"
      data-status="{{item.status}}"
      bindtap="onCaseTap"
    >
      <view class="case-row">
        <view class="case-info">
          <view class="case-title">{{item.title || '调解案例'}}</view>
          <view class="case-relation" wx:if="{{item.relationship}}">{{item.relationship}}</view>
        </view>
        <view class="case-status-tag status-{{item.statusType}}">
          {{item.statusLabel}}
        </view>
      </view>
      <view class="case-meta">
        <text class="case-time">{{item.formattedTime}}</text>
        <text class="case-mode" wx:if="{{item.isSingleMode}}">单人模式</text>
        <text class="case-mode dual" wx:else>双人模式</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{isEmpty && !loading}}">
    <view class="empty-icon">&#x1F4CB;</view>
    <view class="empty-title">还没有调解案例</view>
    <view class="empty-desc">点击上方"开始分析"创建第一个吧</view>
  </view>

  <!-- 加载更多 -->
  <view class="loading-more" wx:if="{{loading && caseList.length > 0}}">
    <view class="spinner"></view>
    <text>加载中...</text>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!hasMore && caseList.length > 0}}">
    <text>— 没有更多了 —</text>
  </view>

  <!-- 安全区 -->
  <view class="safe-bottom"></view>
</view>

<!-- 隐私政策同意弹窗 -->
<view class="privacy-overlay" wx:if="{{showPrivacyModal}}">
  <view class="privacy-modal">
    <view class="privacy-modal-title">欢迎使用啷个对</view>
    <view class="privacy-modal-body">
      <view class="privacy-modal-text">
        我们非常重视您的个人信息安全。在使用本小程序前，请您阅读并同意以下内容：
      </view>
      <view class="privacy-modal-links">
        <view class="privacy-link" bindtap="onViewPrivacy">
          <text class="link-text">《隐私政策》</text>
        </view>
      </view>
      <view class="privacy-modal-text sm">
        您提供的聊天记录将用于 AI 分析，不会公开展示或分享给其他用户。您可以随时删除数据。本小程序使用 DeepSeek API 进行文本处理。
      </view>
      <view class="privacy-modal-check">
        <text>点击"同意并继续"即表示您已阅读并同意上述条款</text>
      </view>
    </view>
    <view class="privacy-modal-actions">
      <button class="privacy-btn disagree" bindtap="onDisagreePrivacy">不同意</button>
      <button class="privacy-btn agree" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onAgreePrivacy">同意并继续</button>
    </view>
  </view>
</view>
