<!-- 首页 (v4) — 啷个对 · 调皮浮夸风 -->
<view class="container">

  <!-- 顶部品牌区域 -->
  <view class="brand-section">
    <view class="brand-emoji-row">
      <text class="brand-emoji b1">😤</text>
      <text class="brand-emoji b2">🤬</text>
      <text class="brand-emoji b3">👄</text>
      <text class="brand-emoji b4">😭</text>
      <text class="brand-emoji b5">😡</text>
    </view>
    <view class="brand-logo">
      <text class="brand-text-gradient">啷个对</text>
    </view>
    <view class="brand-tagline">
      <text class="tagline-text">吵架了？让 AI 来评评理 🤖⚖️</text>
    </view>
  </view>

  <!-- Hero CTA 主卡片 — 浮夸气泡风 -->
  <view class="hero-section">

    <view class="hero-bubble-wrap">
      <!-- 主要大气泡 -->
      <view class="hero-bubble main-bubble">
        <text class="bubble-icon">⚡</text>
        <text class="bubble-text">你有理</text>
      </view>

      <!-- 对面的气泡 -->
      <view class="hero-bubble vs-bubble">
        <text class="bubble-icon">🔥</text>
        <text class="bubble-text">我有理</text>
      </view>

      <!-- AI 裁判 -->
      <view class="hero-judge">
        <text class="judge-icon">🤖</text>
        <text class="judge-label">AI 裁判</text>
      </view>
    </view>

    <!-- 模式选择器 -->
    <view class="mode-selector">
      <view 
        class="mode-card {{mode === 'single' ? 'mode-active' : ''}}"
        data-mode="single"
        catchtap="onSwitchMode"
      >
        <text class="mode-card-icon">🧑‍⚖️</text>
        <view class="mode-card-info">
          <text class="mode-card-name">单人评理</text>
          <text class="mode-card-desc">自己上传 · 秒出结果</text>
        </view>
        <view class="mode-check {{mode === 'single' ? 'check-on' : ''}}">
          <text wx:if="{{mode === 'single'}}">✓</text>
        </view>
      </view>

      <view class="mode-vs-divider">
        <text>VS</text>
      </view>

      <view 
        class="mode-card {{mode === 'dual' ? 'mode-active' : ''}}"
        data-mode="dual"
        catchtap="onSwitchMode"
      >
        <text class="mode-card-icon">👥</text>
        <view class="mode-card-info">
          <text class="mode-card-name">双人对决</text>
          <text class="mode-card-desc">邀请对方 · 一起评理</text>
        </view>
        <view class="mode-check {{mode === 'dual' ? 'check-on' : ''}}">
          <text wx:if="{{mode === 'dual'}}">✓</text>
        </view>
      </view>
    </view>

    <!-- 主 CTA 按钮 -->
    <view class="hero-cta-btn {{creating ? 'cta-loading' : ''}}" catchtap="onStartAnalyze">
      <text class="cta-btn-icon">{{creating ? '⏳' : (mode === 'dual' ? '📨' : '🚀')}}</text>
      <text class="cta-btn-text">{{creating ? '创建中...' : (mode === 'dual' ? '创建邀请链接' : '开始评理！')}}</text>
    </view>

    <view class="hero-cta-sub">
      <text wx:if="{{mode === 'single'}}">上传聊天记录或截图 · 30 秒出结果</text>
      <text wx:else>生成邀请码发给对方，双方各自上传聊天记录</text>
    </view>
  </view>

  <!-- 三点卖点 -->
  <view class="features-row">
    <view class="feature-chip">
      <text class="chip-icon">📸</text>
      <text class="chip-text">截图即分析</text>
    </view>
    <view class="feature-chip">
      <text class="chip-icon">🤫</text>
      <text class="chip-text">全程匿名</text>
    </view>
    <view class="feature-chip">
      <text class="chip-icon">💬</text>
      <text class="chip-text">AI 追问</text>
    </view>
  </view>

  <!-- 案例区标题 -->
  <view class="section-header" wx:if="{{!isEmpty}}">
    <view class="section-title-wrap">
      <text class="section-icon">📋</text>
      <text class="section-title">我的评理记录</text>
    </view>
    <view class="section-badge">
      <text>{{caseList.length}}</text>
    </view>
  </view>

  <!-- 案例列表 — 重新设计卡片 -->
  <view class="case-list" wx:if="{{!isEmpty}}">
    <view
      class="case-card-new"
      wx:for="{{caseList}}"
      wx:key="_id"
      data-id="{{item._id}}"
      data-status="{{item.status}}"
      bindtap="onCaseTap"
    >
      <!-- 左侧状态指示条 -->
      <view class="case-stripe stripe-{{item.statusType}}"></view>

      <view class="case-body">
        <view class="case-top-row">
          <view class="case-title-wrap">
            <text class="case-emoji">{{item.isSingleMode ? '🧑‍⚖️' : '👥'}}</text>
            <text class="case-title">{{item.title || '评理现场'}}</text>
          </view>

          <!-- 状态标签 -->
          <view class="case-badge badge-{{item.statusType}}">
            <text class="badge-dot"></text>
            <text>{{item.statusLabel}}</text>
          </view>
        </view>

        <view class="case-bottom-row">
          <text class="case-meta-text">{{item.formattedTime}}</text>
          <text class="case-divider-dot">·</text>
          <text class="case-meta-tag">{{item.isSingleMode ? '单人模式' : '双人对决'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 — 调皮版 -->
  <view class="empty-fun" wx:if="{{isEmpty && !loading}}">
    <view class="empty-graphic">
      <text class="empty-big-emoji">🫣</text>
    </view>
    <text class="empty-fun-title">还没人来找我评理呢！</text>
    <text class="empty-fun-desc">快戳上面那个红按钮试试呗~</text>
  </view>

  <!-- 加载 -->
  <view class="loading-more" wx:if="{{loading && caseList.length > 0}}">
    <view class="spinner"></view>
    <text>翻箱倒柜中...</text>
  </view>

  <view class="no-more" wx:if="{{!hasMore && caseList.length > 0}}">
    <text>—— 到底了，没有更多啦 ——</text>
  </view>

  <view class="safe-bottom"></view>
</view>

<!-- 隐私政策弹窗 — 沿用但优化文案 -->
<view class="privacy-overlay" wx:if="{{showPrivacyModal}}">
  <view class="privacy-modal">
    <view class="privacy-modal-icon">🤝</view>
    <view class="privacy-modal-title">欢迎来到啷个对</view>
    <view class="privacy-modal-body">
      <view class="privacy-modal-text">
        我们非常重视您的个人信息安全。在使用本小程序前，请您阅读并同意以下内容：
      </view>
      <view class="privacy-modal-links">
        <view class="privacy-link" bindtap="onViewPrivacy">
          <text class="link-text">📜 《隐私政策》</text>
        </view>
      </view>
      <view class="privacy-modal-text sm">
        你的聊天记录仅用于 AI 分析，不会公开或分享。你可以随时删除所有数据。本小程序使用 DeepSeek API 进行文本处理。
      </view>
      <view class="privacy-modal-check">
        <text>点击「同意并继续」即表示你已阅读并同意上述内容</text>
      </view>
    </view>
    <view class="privacy-modal-actions">
      <button class="privacy-btn disagree" bindtap="onDisagreePrivacy">不了，告辞</button>
      <button class="privacy-btn agree" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onAgreePrivacy">同意并继续 🎉</button>
    </view>
  </view>
</view>
