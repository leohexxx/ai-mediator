<!-- V3 首页：先整理证据，再分析分歧 -->
<view class="container home-page">
  <view class="brand-section">
    <view class="brand-kicker">啷个对 · V3</view>
    <view class="brand-title">先把事实说清楚</view>
    <view class="brand-desc">整理聊天证据、标出信息缺口，再由 AI 帮你看见分歧和下一步。</view>
  </view>

  <view class="mode-panel">
    <view class="mode-heading">这次由谁提供证据？</view>
    <view class="mode-selector">
      <view class="mode-card {{mode === 'single' ? 'mode-active' : ''}}" data-mode="single" catchtap="onSwitchMode">
        <view class="mode-index">01</view>
        <view class="mode-card-name">我先整理</view>
        <view class="mode-card-desc">先用自己的记录形成初步报告，后续可以继续补证。</view>
        <view class="mode-state">{{mode === 'single' ? '已选择' : '选择'}}</view>
      </view>
      <view class="mode-card {{mode === 'dual' ? 'mode-active' : ''}}" data-mode="dual" catchtap="onSwitchMode">
        <view class="mode-index">02</view>
        <view class="mode-card-name">邀请另一方</view>
        <view class="mode-card-desc">双方分别补充证据；分析开始后，本轮证据会同时锁定。</view>
        <view class="mode-state">{{mode === 'dual' ? '已选择' : '选择'}}</view>
      </view>
    </view>

    <button class="primary-action" bindtap="onStartAnalyze" loading="{{creating}}" disabled="{{creating}}">
      {{creating ? '正在创建...' : (mode === 'dual' ? '创建双人案例' : '开始整理证据')}}
    </button>
    <view class="action-note" wx:if="{{mode === 'single'}}">每次最多选择 9 张截图，可连续追加；OCR 校对后再进入分析。</view>
    <view class="action-note" wx:else>任意一方有自己的有效证据即可分析；分析期间双方不能修改证据。</view>
  </view>

  <view class="process-strip">
    <view class="process-item"><text class="process-no">A</text><text>OCR 与去重</text></view>
    <view class="process-line"></view>
    <view class="process-item"><text class="process-no">B</text><text>事实与缺口</text></view>
    <view class="process-line"></view>
    <view class="process-item"><text class="process-no">C</text><text>行动建议</text></view>
  </view>

  <view class="privacy-brief">
    <view class="brief-mark"></view>
    <view class="brief-content">
      <view class="brief-title">必要信息才进入模型</view>
      <view class="brief-text">后端先完成去重、统计、事实提取和敏感字段脱敏；仅复杂语义交给 AI。报告是辅助整理，不替代法律、心理或安全专业意见。</view>
    </view>
  </view>

  <view class="section-header" wx:if="{{!isEmpty}}">
    <view>
      <view class="section-kicker">CASES</view>
      <view class="section-title">最近案例</view>
    </view>
    <view class="section-count">{{caseList.length}}</view>
  </view>

  <view class="case-list" wx:if="{{!isEmpty}}">
    <view class="case-card-new" wx:for="{{caseList}}" wx:key="_id" data-id="{{item._id}}" data-status="{{item.status}}" bindtap="onCaseTap">
      <view class="case-stripe stripe-{{item.statusType}}"></view>
      <view class="case-body">
        <view class="case-top-row">
          <view class="case-title">{{item.title || '沟通案例'}}</view>
          <view class="case-badge badge-{{item.statusType}}"><text class="badge-dot"></text>{{item.statusLabel}}</view>
        </view>
        <view class="case-bottom-row">
          <text>{{item.isSingleMode ? '单人整理' : '双人协作'}}</text>
          <text class="case-separator">/</text>
          <text>{{item.formattedTime}}</text>
        </view>
      </view>
      <view class="case-arrow">›</view>
    </view>
  </view>

  <view class="empty-state-v3" wx:if="{{isEmpty && !loading}}">
    <view class="empty-number">00</view>
    <view class="empty-title">还没有案例</view>
    <view class="empty-desc">先从一组连续的聊天截图开始。</view>
  </view>

  <view class="loading-more" wx:if="{{loading && caseList.length > 0}}">正在加载更多案例...</view>
  <view class="no-more" wx:if="{{!hasMore && caseList.length > 0}}">没有更多记录</view>
  <view class="safe-bottom"></view>
</view>

<view class="privacy-overlay" wx:if="{{showPrivacyModal}}">
  <view class="privacy-modal">
    <view class="privacy-step">使用前请确认</view>
    <view class="privacy-modal-title">你是否有权提交这些聊天记录？</view>
    <view class="privacy-modal-text">聊天文本会在服务端处理；必要的脱敏片段会发送给已配置的 AI 服务商。请勿上传与争议无关的身份证、银行卡、住址等敏感信息。</view>
    <view class="privacy-link" bindtap="onViewPrivacy">查看《隐私政策》</view>
    <view class="privacy-modal-actions">
      <button class="privacy-btn disagree" bindtap="onDisagreePrivacy">暂不使用</button>
      <button class="privacy-btn agree" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onAgreePrivacy">同意并继续</button>
    </view>
  </view>
</view>
