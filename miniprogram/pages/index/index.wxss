.home-page { position: relative; overflow: hidden; padding-top: 54rpx; }
.home-page::before { content: ''; position: absolute; top: -180rpx; right: -220rpx; width: 540rpx; height: 540rpx; border: 1rpx solid rgba(194,160,90,.12); border-radius: 50%; pointer-events: none; }
.brand-section { position: relative; z-index: 1; margin-bottom: 46rpx; }
.brand-eyebrow,.section-kicker,.privacy-kicker { color: var(--color-accent); font-size: 19rpx; letter-spacing: 5rpx; }
.brand-logo { margin-top: 8rpx; font-family: 'Songti SC','STSong','SimSun',serif; font-size: 88rpx; font-weight: 700; line-height: 1.05; letter-spacing: 4rpx; color: var(--color-text-primary); }
.brand-tagline { margin-top: 14rpx; color: var(--color-text-secondary); font-size: 27rpx; letter-spacing: 1rpx; }

.hero-section { position: relative; z-index: 1; }
.hero-stage { position: relative; height: 300rpx; margin: 0 0 44rpx; }
.statement { position: absolute; display: flex; align-items: baseline; min-width: 310rpx; padding: 24rpx 28rpx; box-sizing: border-box; border: 1rpx solid var(--color-border); box-shadow: var(--shadow-md); }
.statement-a { top: 0; left: 0; background: var(--color-brand-dark); border-radius: 8rpx 28rpx 28rpx 28rpx; transform: rotate(-1.5deg); }
.statement-b { right: 0; bottom: 0; justify-content: flex-end; background: var(--color-card); border-radius: 28rpx 8rpx 28rpx 28rpx; transform: rotate(1.5deg); }
.statement-index { margin-right: 18rpx; color: var(--color-accent); font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }
.statement-text { color: var(--color-text-primary); font-family: 'Songti SC','STSong','SimSun',serif; font-size: 35rpx; font-weight: 700; white-space: nowrap; }
.ai-seal { position: absolute; left: 50%; top: 50%; z-index: 3; width: 106rpx; height: 106rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; transform: translate(-50%,-50%) rotate(-6deg); border-radius: 50%; background: var(--color-accent); color: #252129; box-shadow: 0 20rpx 44rpx rgba(9,8,12,.35); }
.seal-main { font-size: 30rpx; font-weight: 800; line-height: 1; letter-spacing: 1rpx; }
.seal-sub { margin-top: 6rpx; font-size: 17rpx; letter-spacing: 2rpx; }

.mode-heading { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 20rpx; }
.mode-heading-title { font-family: 'Songti SC','STSong','SimSun',serif; font-size: 36rpx; font-weight: 700; }
.mode-heading-note { color: var(--color-text-muted); font-size: 20rpx; }
.mode-selector { display: flex; flex-direction: column; gap: 14rpx; }
.mode-card { display: flex; align-items: center; min-height: 112rpx; padding: 20rpx 22rpx; box-sizing: border-box; background: rgba(255,255,255,.035); border: 1rpx solid var(--color-border); border-radius: var(--radius-md); transition: all var(--transition-normal); }
.mode-card.mode-active { background: rgba(169,79,96,.12); border-color: rgba(201,120,136,.6); transform: translateX(8rpx); }
.mode-number { width: 72rpx; color: var(--color-accent); font-family: Georgia,serif; font-size: 24rpx; letter-spacing: 2rpx; }
.mode-card-info { flex: 1; display: flex; flex-direction: column; }
.mode-card-name { font-size: 30rpx; font-weight: 650; color: var(--color-text-primary); }
.mode-card-desc { margin-top: 3rpx; font-size: 22rpx; color: var(--color-text-muted); }
.mode-check { min-width: 62rpx; text-align: right; color: var(--color-text-muted); font-size: 20rpx; }
.mode-check.check-on { color: var(--color-brand-light); }

.hero-cta-btn { display: flex; align-items: center; justify-content: space-between; min-height: 104rpx; margin-top: 24rpx; padding: 0 34rpx; color: #F8F3EC; background: var(--color-brand); border-radius: var(--radius-md); box-shadow: 0 22rpx 54rpx rgba(127,53,68,.28); transition: transform var(--transition-fast), opacity var(--transition-fast); }
.hero-cta-btn.cta-loading { opacity: .65; }
.cta-btn-text { font-size: 31rpx; font-weight: 700; letter-spacing: 2rpx; }
.cta-arrow { font-size: 42rpx; font-weight: 300; }
.hero-cta-sub { margin: 15rpx 4rpx 0; color: var(--color-text-muted); font-size: 21rpx; }

.features-row { display: flex; justify-content: space-between; margin: 58rpx 0 72rpx; padding: 25rpx 0; border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); }
.feature-item { display: flex; flex-direction: column; color: var(--color-text-secondary); font-size: 22rpx; }
.feature-mark { margin-bottom: 3rpx; color: var(--color-accent); font-size: 17rpx; letter-spacing: 2rpx; }

.section-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 24rpx; }
.section-title { display: block; margin-top: 5rpx; font-family: 'Songti SC','STSong','SimSun',serif; font-size: 39rpx; font-weight: 700; }
.section-badge { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; color: #252129; background: var(--color-accent); border-radius: 50%; font-size: 20rpx; font-weight: 700; }
.case-list { display: flex; flex-direction: column; gap: 14rpx; }
.case-card-new { position: relative; display: flex; min-height: 128rpx; overflow: hidden; background: rgba(255,255,255,.035); border: 1rpx solid var(--color-border); border-radius: var(--radius-md); }
.case-card-new:active { background: var(--color-card-hover); }
.case-stripe { width: 5rpx; background: var(--color-text-muted); }
.stripe-success,.stripe-completed { background: var(--color-success); }
.stripe-analyzing,.stripe-processing { background: var(--color-accent); }
.stripe-waiting,.stripe-pending { background: var(--color-warning); }
.stripe-error,.stripe-failed { background: var(--color-error); }
.case-body { flex: 1; padding: 23rpx 25rpx; }
.case-top-row,.case-bottom-row { display: flex; align-items: center; justify-content: space-between; }
.case-title-wrap { min-width: 0; flex: 1; }
.case-mode { color: var(--color-accent); font-size: 16rpx; letter-spacing: 3rpx; }
.case-title { display: block; max-width: 390rpx; margin-top: 2rpx; overflow: hidden; color: var(--color-text-primary); font-size: 28rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.case-badge { display: flex; align-items: center; margin-left: 14rpx; color: var(--color-text-secondary); font-size: 19rpx; }
.badge-dot { width: 8rpx; height: 8rpx; margin-right: 7rpx; background: currentColor; border-radius: 50%; }
.badge-success,.badge-completed { color: var(--color-success); }
.badge-analyzing,.badge-processing { color: var(--color-accent); }
.badge-error,.badge-failed { color: var(--color-error); }
.case-bottom-row { justify-content: flex-start; margin-top: 11rpx; color: var(--color-text-muted); font-size: 20rpx; }
.case-divider-dot { margin: 0 10rpx; color: var(--color-border-light); }

.empty-fun { position: relative; min-height: 310rpx; padding: 62rpx 38rpx; box-sizing: border-box; overflow: hidden; background: rgba(255,255,255,.025); border: 1rpx solid var(--color-border); border-radius: var(--radius-lg); }
.empty-quote { position: absolute; top: -35rpx; right: 28rpx; color: rgba(194,160,90,.18); font-family: Georgia,serif; font-size: 240rpx; line-height: 1; }
.empty-fun-title { position: relative; display: block; margin-top: 42rpx; font-family: 'Songti SC','STSong','SimSun',serif; font-size: 39rpx; font-weight: 700; }
.empty-fun-desc { position: relative; display: block; margin-top: 14rpx; color: var(--color-text-muted); font-size: 23rpx; }
.loading-more,.no-more { display: flex; align-items: center; justify-content: center; gap: 12rpx; padding: 38rpx 0; color: var(--color-text-muted); font-size: 20rpx; letter-spacing: 2rpx; }
.spinner { width: 22rpx; height: 22rpx; border: 2rpx solid var(--color-border-light); border-top-color: var(--color-accent); border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.privacy-overlay { position: fixed; inset: 0; z-index: var(--z-modal); display: flex; align-items: flex-end; justify-content: center; padding: 28rpx; box-sizing: border-box; background: rgba(18,17,23,.84); }
.privacy-modal { width: 100%; padding: 46rpx 36rpx 34rpx; box-sizing: border-box; background: #24222C; border: 1rpx solid var(--color-border-light); border-radius: 24rpx 24rpx 8rpx 8rpx; box-shadow: var(--shadow-lg); }
.privacy-modal-title { margin-top: 10rpx; font-family: 'Songti SC','STSong','SimSun',serif; font-size: 38rpx; font-weight: 700; }
.privacy-modal-body { margin-top: 26rpx; }
.privacy-modal-text { color: var(--color-text-secondary); font-size: 24rpx; line-height: 1.75; }
.privacy-modal-text.sm { color: var(--color-text-muted); font-size: 21rpx; }
.privacy-modal-links { margin: 20rpx 0; padding: 18rpx 0; border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); }
.link-text { color: var(--color-accent); font-size: 24rpx; }
.privacy-modal-check { margin-top: 18rpx; color: var(--color-text-muted); font-size: 19rpx; }
.privacy-modal-actions { display: flex; gap: 14rpx; margin-top: 30rpx; }
.privacy-btn { flex: 1; min-height: 84rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-md); font-size: 25rpx; }
.privacy-btn.disagree { color: var(--color-text-secondary); background: transparent; border: 1rpx solid var(--color-border-light); }
.privacy-btn.agree { color: #F8F3EC; background: var(--color-brand); }
