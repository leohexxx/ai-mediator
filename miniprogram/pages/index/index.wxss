/* 首页样式 (v2) */

/* ===== Hero CTA ===== */
.hero-cta {
  text-align: center;
  padding: 56rpx 40rpx 48rpx;
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.12), rgba(236, 72, 153, 0.08));
  border: 1rpx solid rgba(99, 102, 241, 0.25);
  border-radius: 24rpx;
}

.hero-icon {
  margin-bottom: 20rpx;
}

.hero-emoji {
  font-size: 72rpx;
  line-height: 1;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.hero-btn {
  display: inline-block;
  margin-top: 36rpx;
  padding: 20rpx 80rpx;
  background: var(--color-brand);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 48rpx;
  transition: opacity 0.2s;
}

.hero-btn-loading {
  opacity: 0.6;
}

/* ===== Section Header ===== */
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 40rpx 0 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-count {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* ===== Case Item ===== */
.case-item {
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}

.case-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.case-info {
  flex: 1;
  min-width: 0;
}

.case-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.case-relation {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.case-status-tag {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
}

.status-success {
  background: rgba(34, 197, 94, 0.15);
  color: #22c55e;
}

.status-analyzing {
  background: rgba(99, 102, 241, 0.15);
  color: #818cf8;
}

.status-pending {
  background: rgba(234, 179, 8, 0.15);
  color: #facc15;
}

.status-expired {
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
}

.case-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.case-time {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.case-mode {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(99, 102, 241, 0.1);
  color: #818cf8;
}

.case-mode.dual {
  background: rgba(236, 72, 153, 0.1);
  color: #f472b6;
}

/* ===== 加载 ===== */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.spinner {
  display: inline-block;
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--color-border);
  border-top-color: var(--color-brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 32rpx 0 48rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* ===== 空状态 ===== */
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.empty-desc {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 8rpx;
}

/* ===== 安全区 ===== */
.safe-bottom {
  height: env(safe-area-inset-bottom, 32rpx);
}
