.home-page { padding-top: 48rpx; }

.brand-section { padding: 8rpx 8rpx 44rpx 24rpx; max-width: 630rpx; }
.brand-kicker, .section-kicker { color: var(--color-brand); font-size: 20rpx; letter-spacing: 5rpx; font-weight: 700; }
.brand-title { margin-top: 12rpx; font-size: 64rpx; line-height: 1.08; font-weight: 800; letter-spacing: -2rpx; color: var(--color-text-primary); }
.brand-desc { margin-top: 22rpx; font-size: 27rpx; line-height: 1.75; color: var(--color-text-secondary); }

.mode-panel { position: relative; padding: 30rpx; background: var(--color-card); border: 1rpx solid var(--color-border); border-left: 8rpx solid var(--color-brand); }
.mode-heading { font-size: 25rpx; font-weight: 700; color: var(--color-text-primary); margin-bottom: 22rpx; }
.mode-selector { display: flex; gap: 16rpx; }
.mode-card { position: relative; flex: 1; min-height: 218rpx; padding: 22rpx; box-sizing: border-box; border: 1rpx solid var(--color-border); background: var(--color-bg-secondary); }
.mode-card:active { opacity: .78; }
.mode-card.mode-active { border-color: var(--color-brand); background: rgba(255, 77, 106, .14); box-shadow: 0 8rpx 22rpx rgba(255, 77, 106, .16); }
.mode-index { color: var(--color-warning); font-size: 18rpx; letter-spacing: 2rpx; }
.mode-card-name { margin-top: 14rpx; font-size: 29rpx; font-weight: 700; color: var(--color-text-primary); }
.mode-card-desc { margin-top: 10rpx; padding-bottom: 32rpx; font-size: 21rpx; line-height: 1.55; color: var(--color-text-secondary); }
.mode-state { position: absolute; left: 22rpx; bottom: 18rpx; font-size: 20rpx; color: var(--color-brand); font-weight: 700; }
.primary-action { width: 100%; margin-top: 24rpx; border-radius: 0; background: var(--color-brand); color: #fff; font-size: 29rpx; font-weight: 700; letter-spacing: 1rpx; box-shadow: 0 9rpx 24rpx rgba(255, 77, 106, .3); }
.primary-action::after, .privacy-btn::after { border: 0; }
.action-note { margin-top: 16rpx; color: var(--color-text-muted); font-size: 21rpx; line-height: 1.6; }

.process-strip { display: flex; align-items: center; padding: 34rpx 8rpx; }
.process-item { display: flex; flex-direction: column; gap: 6rpx; color: var(--color-text-secondary); font-size: 20rpx; white-space: nowrap; }
.process-no { color: var(--color-brand); font-weight: 800; }
.process-line { flex: 1; height: 1rpx; margin: 0 15rpx; background: var(--color-border); }

.privacy-brief { display: flex; padding: 26rpx 24rpx; background: rgba(168, 85, 247, .13); border-top: 1rpx solid rgba(192, 132, 252, .34); border-bottom: 1rpx solid rgba(192, 132, 252, .34); }
.brief-mark { width: 9rpx; min-height: 84rpx; background: var(--color-warning); margin-right: 20rpx; }
.brief-content { flex: 1; }
.brief-title { font-size: 25rpx; font-weight: 700; color: var(--color-text-primary); }
.brief-text { margin-top: 8rpx; font-size: 21rpx; line-height: 1.65; color: var(--color-text-secondary); }

.section-header { display: flex; align-items: flex-end; justify-content: space-between; margin: 56rpx 6rpx 20rpx; }
.section-title { margin-top: 5rpx; font-size: 37rpx; line-height: 1.2; font-weight: 800; }
.section-count { color: var(--color-text-muted); font-size: 22rpx; border-bottom: 2rpx solid var(--color-warning); padding: 0 4rpx 4rpx; }
.case-list { border-top: 1rpx solid var(--color-border); }
.case-card-new { position: relative; display: flex; align-items: stretch; min-height: 126rpx; border-bottom: 1rpx solid var(--color-border); background: transparent; }
.case-card-new:active { background: rgba(255, 255, 255, .06); }
.case-stripe { width: 5rpx; background: var(--color-border); }
.stripe-success { background: var(--color-success); }
.stripe-warning { background: var(--color-warning); }
.stripe-error { background: var(--color-error); }
.case-body { flex: 1; padding: 23rpx 18rpx; min-width: 0; }
.case-top-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.case-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; font-weight: 700; }
.case-badge { display: flex; align-items: center; gap: 8rpx; color: var(--color-text-secondary); font-size: 19rpx; }
.badge-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: currentColor; }
.case-bottom-row { display: flex; gap: 10rpx; margin-top: 13rpx; font-size: 20rpx; color: var(--color-text-muted); }
.case-separator { color: var(--color-warning); }
.case-arrow { display: flex; align-items: center; padding: 0 10rpx; color: var(--color-text-muted); font-size: 44rpx; }

.empty-state-v3 { margin-top: 64rpx; padding: 52rpx 24rpx; border-top: 1rpx solid var(--color-border); border-bottom: 1rpx solid var(--color-border); }
.empty-number { font-size: 80rpx; line-height: 1; font-weight: 800; color: #59407D; }
.empty-title { margin-top: -6rpx; font-size: 30rpx; font-weight: 700; }
.empty-desc, .loading-more, .no-more { margin-top: 12rpx; font-size: 22rpx; color: var(--color-text-muted); }
.loading-more, .no-more { text-align: center; padding: 24rpx 0; }

.privacy-overlay { position: fixed; inset: 0; z-index: 400; display: flex; align-items: flex-end; background: rgba(4, 2, 12, .74); }
.privacy-modal { width: 100%; padding: 42rpx 36rpx calc(32rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: var(--color-bg); border-top: 8rpx solid var(--color-brand); }
.privacy-step { color: var(--color-brand); font-size: 20rpx; font-weight: 700; letter-spacing: 4rpx; }
.privacy-modal-title { margin-top: 14rpx; font-size: 38rpx; font-weight: 800; line-height: 1.35; }
.privacy-modal-text { margin-top: 20rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 1.75; }
.privacy-link { display: inline-block; margin-top: 20rpx; padding-bottom: 3rpx; color: var(--color-brand); border-bottom: 1rpx solid var(--color-brand); font-size: 23rpx; }
.privacy-modal-actions { display: flex; gap: 16rpx; margin-top: 30rpx; }
.privacy-btn { flex: 1; border-radius: 0; font-size: 26rpx; }
.privacy-btn.disagree { color: var(--color-text-secondary); background: transparent; border: 1rpx solid var(--color-border); }
.privacy-btn.agree { color: #fff; background: var(--color-brand); }
