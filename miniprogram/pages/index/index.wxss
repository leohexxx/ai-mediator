/* 首页样式 (v4) — 调皮浮夸风 */

/* ===== 顶部品牌区域 ===== */
.brand-section {
  text-align: center;
  padding: 48rpx 0 28rpx;
}

.brand-emoji-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  animation: float 3s ease-in-out infinite;
}

.brand-emoji {
  font-size: 36rpx;
}

.brand-emoji.b1 { animation-delay: 0s; }
.brand-emoji.b2 { animation-delay: 0.15s; }
.brand-emoji.b3 { animation-delay: 0.3s; }
.brand-emoji.b4 { animation-delay: 0.45s; }
.brand-emoji.b5 { animation-delay: 0.6s; }

.brand-logo {
  margin-bottom: 12rpx;
}

.brand-text-gradient {
  font-size: 72rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  background: linear-gradient(135deg, #FF4D6A 0%, #A855F7 40%, #60A5FA 70%, #FF4D6A 100%);
  background-size: 300% 100%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: shimmer 4s ease-in-out infinite;
}

.brand-tagline {
  margin-bottom: 8rpx;
}

.tagline-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  letter-spacing: 2rpx;
}

/* ===== Hero 主区域 ===== */
.hero-section {
  margin: 8rpx 0 24rpx;
  padding: 32rpx 24rpx 28rpx;
  background: linear-gradient(160deg, rgba(255, 77, 106, 0.1) 0%, rgba(168, 85, 247, 0.15) 50%, rgba(96, 165, 250, 0.08) 100%);
  border: 2rpx solid rgba(168, 85, 247, 0.3);
  border-radius: var(--radius-lg);
  position: relative;
  overflow: visible;
}

/* 气泡对决区 */
.hero-bubble-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
  padding: 16rpx 0;
}

.hero-bubble {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  position: relative;
}

.main-bubble {
  background: linear-gradient(135deg, rgba(255, 77, 106, 0.25), rgba(255, 77, 106, 0.08));
  border: 3rpx solid rgba(255, 77, 106, 0.5);
  box-shadow: 0 0 40rpx rgba(255, 77, 106, 0.2);
  animation: float 3.5s ease-in-out infinite;
}

.vs-bubble {
  background: linear-gradient(135deg, rgba(168, 85, 247, 0.25), rgba(168, 85, 247, 0.08));
  border: 3rpx solid rgba(168, 85, 247, 0.5);
  box-shadow: 0 0 40rpx rgba(168, 85, 247, 0.2);
  animation: float 3.5s ease-in-out infinite;
  animation-delay: 1.5s;
}

.bubble-icon {
  font-size: 48rpx;
  margin-bottom: 6rpx;
}

.bubble-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

/* AI 裁判气泡 */
.hero-judge {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
}

.judge-icon {
  font-size: 52rpx;
  filter: drop-shadow(0 0 16rpx rgba(255, 77, 106, 0.5));
  animation: float 2.5s ease-in-out infinite;
}

.judge-label {
  font-size: 18rpx;
  color: var(--color-text-muted);
  background: var(--color-card);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-top: 4rpx;
}

/* ===== 模式切换器 ===== */
.mode-selector {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 8rpx;
  margin-bottom: 20rpx;
}

.mode-card {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 16rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  border-radius: var(--radius-md);
  transition: all 0.2s ease;
  position: relative;
}

.mode-card:active {
  transform: scale(0.97);
}

.mode-active {
  background: linear-gradient(135deg, rgba(255, 77, 106, 0.15), rgba(168, 85, 247, 0.15));
  border-color: rgba(168, 85, 247, 0.5);
  box-shadow: 0 0 20rpx rgba(168, 85, 247, 0.15);
}

.mode-card-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.mode-card-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.mode-card-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  white-space: nowrap;
}

.mode-card-desc {
  font-size: 20rpx;
  color: var(--color-text-muted);
  white-space: nowrap;
}

.mode-active .mode-card-desc {
  color: var(--color-accent-glow);
}

.mode-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: transparent;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.check-on {
  background: linear-gradient(135deg, #FF4D6A, #A855F7);
  border-color: transparent;
  color: #FFF;
  font-weight: 700;
}

.mode-vs-divider {
  flex-shrink: 0;
}

.mode-vs-divider text {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-text-muted);
  letter-spacing: 2rpx;
}

/* CTA 按钮 */
.hero-cta-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, #FF4D6A 0%, #A855F7 100%);
  border-radius: var(--radius-xl);
  box-shadow: 0 8rpx 32rpx rgba(255, 77, 106, 0.35);
  transition: all 0.2s ease;
}

.cta-loading {
  opacity: 0.7;
}

.cta-btn-icon {
  font-size: 36rpx;
}

.cta-btn-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}

.hero-cta-sub {
  text-align: center;
  margin-top: 16rpx;
}

.hero-cta-sub text {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

/* ===== 三点卖点 ===== */
.features-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.feature-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-xl);
}

.chip-icon {
  font-size: 24rpx;
}

.chip-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  white-space: nowrap;
}

/* ===== 案例区 ===== */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 0 20rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-icon {
  font-size: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.section-badge {
  background: linear-gradient(135deg, #FF4D6A, #A855F7);
  color: #FFF;
  font-size: 22rpx;
  font-weight: 700;
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  padding: 0 10rpx;
}

/* ===== 案例卡片 (新设计) ===== */
.case-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.case-card-new {
  display: flex;
  background: var(--color-card);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: all 0.15s ease;
}

.case-card-new:active {
  background: var(--color-card-hover);
  transform: scale(0.985);
}

/* 左侧彩色指示条 */
.case-stripe {
  width: 8rpx;
  flex-shrink: 0;
  border-radius: 4rpx 0 0 4rpx;
}

.stripe-success { background: var(--color-success); }
.stripe-analyzing { background: linear-gradient(180deg, #A855F7, #FF4D6A); animation: glowPulse 2s ease-in-out infinite; }
.stripe-pending { background: var(--color-warning); }
.stripe-expired { background: var(--color-text-muted); }

.case-body {
  flex: 1;
  padding: 24rpx 24rpx 24rpx 16rpx;
  min-width: 0;
}

.case-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.case-title-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.case-emoji {
  font-size: 26rpx;
  flex-shrink: 0;
}

.case-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 状态徽章 */
.case-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  font-weight: 500;
  border-radius: var(--radius-xl);
  flex-shrink: 0;
  margin-left: 12rpx;
}

.badge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.badge-success {
  background: rgba(52, 211, 153, 0.12);
  color: var(--color-success);
}
.badge-success .badge-dot { background: var(--color-success); }

.badge-analyzing {
  background: rgba(168, 85, 247, 0.12);
  color: var(--color-accent-glow);
}
.badge-analyzing .badge-dot {
  background: var(--color-accent-glow);
  animation: glowPulse 1.2s ease-in-out infinite;
}

.badge-pending {
  background: rgba(251, 191, 36, 0.12);
  color: var(--color-warning);
}
.badge-pending .badge-dot { background: var(--color-warning); }

.badge-expired {
  background: rgba(123, 107, 158, 0.12);
  color: var(--color-text-muted);
}
.badge-expired .badge-dot { background: var(--color-text-muted); }

.case-bottom-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.case-meta-text {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.case-divider-dot {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.case-meta-tag {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  padding: 2rpx 10rpx;
  background: rgba(168, 85, 247, 0.08);
  border-radius: 8rpx;
}

/* ===== 空状态 (调皮版) ===== */
.empty-fun {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
}

.empty-graphic {
  margin-bottom: 24rpx;
}

.empty-big-emoji {
  font-size: 120rpx;
  animation: float 3s ease-in-out infinite;
}

.empty-fun-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.empty-fun-desc {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* ===== 加载 ===== */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: var(--color-text-muted);
  gap: 12rpx;
}

.spinner {
  display: inline-block;
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--color-border);
  border-top-color: var(--color-accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 32rpx 0 48rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* ===== 安全区 ===== */
.safe-bottom {
  height: env(safe-area-inset-bottom, 48rpx);
}

/* ===== 隐私弹窗 (保持可用) ===== */
.privacy-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.privacy-modal {
  width: 86vw;
  max-height: 85vh;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 40rpx 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
}

.privacy-modal-icon {
  text-align: center;
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.privacy-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 24rpx;
}

.privacy-modal-body {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 24rpx;
}

.privacy-modal-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin-bottom: 16rpx;
}

.privacy-modal-text.sm {
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.6;
  padding: 16rpx;
  background: var(--color-bg-secondary);
  border-radius: 12rpx;
}

.privacy-modal-links { margin-bottom: 16rpx; }
.privacy-link { padding: 8rpx 0; }

.link-text {
  font-size: 26rpx;
  color: var(--color-accent-glow);
  text-decoration: underline;
}

.privacy-modal-check {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.privacy-modal-actions {
  display: flex;
  gap: 16rpx;
}

.privacy-btn {
  flex: 1;
  padding: 22rpx 24rpx;
  text-align: center;
  border-radius: var(--radius-xl);
  font-size: 28rpx;
  font-weight: 600;
}

.privacy-btn.disagree {
  background: var(--color-bg-secondary);
  color: var(--color-text-muted);
}

.privacy-btn.agree {
  background: linear-gradient(135deg, #FF4D6A, #A855F7);
  color: #FFFFFF;
}
