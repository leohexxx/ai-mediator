/* 啷个对 V3.6 — 克制俏皮的编辑杂志风设计变量 */
page {
  --color-brand: #A94F60;
  --color-brand-light: #C97888;
  --color-brand-dark: #7F3544;
  --color-accent: #C2A05A;

  --color-bg: #191820;
  --color-bg-secondary: #201F27;
  --color-bg-tertiary: #2A2831;
  --color-card: #24222C;
  --color-card-hover: #2B2934;
  --color-card-active: #322F3A;

  --color-border: rgba(243, 239, 232, 0.12);
  --color-border-light: rgba(243, 239, 232, 0.22);
  --color-text-primary: #F3EFE8;
  --color-text-secondary: #C7C0B8;
  --color-text-muted: #89838C;

  --color-success: #8E9B80;
  --color-success-bg: rgba(104, 115, 94, 0.18);
  --color-warning: #C2A05A;
  --color-warning-bg: rgba(194, 160, 90, 0.16);
  --color-error: #B85E61;
  --color-error-bg: rgba(184, 94, 97, 0.16);
  --color-info: #71808D;
  --color-info-bg: rgba(113, 128, 141, 0.16);

  --color-party-a: #A94F60;
  --color-party-b: #89838C;
  --color-score-a: #A94F60;
  --color-score-b: #B2A8B5;
  --color-bubble-user: #7F3544;
  --color-bubble-ai: #2A2831;
  --color-bubble-ai-border: rgba(194, 160, 90, 0.28);

  --radius-xs: 4rpx;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-full: 9999rpx;

  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --space-2xl: 64rpx;

  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 38rpx;
  --font-2xl: 48rpx;
  --font-3xl: 68rpx;

  --font-normal: 400;
  --font-medium: 500;
  --font-semibold: 600;
  --font-bold: 700;

  --shadow-sm: 0 8rpx 28rpx rgba(9, 8, 12, 0.16);
  --shadow-md: 0 18rpx 48rpx rgba(9, 8, 12, 0.22);
  --shadow-lg: 0 28rpx 80rpx rgba(9, 8, 12, 0.28);

  --transition-fast: 0.15s ease;
  --transition-normal: 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  --transition-slow: 0.45s cubic-bezier(0.22, 1, 0.36, 1);

  --z-base: 1;
  --z-dropdown: 100;
  --z-sticky: 200;
  --z-overlay: 300;
  --z-modal: 400;
  --z-toast: 500;
}
