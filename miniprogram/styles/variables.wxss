/* ═══════════════════════════════════════════════
  啷个对 — 设计系统 CSS 变量
   活力暗色主题
   ═══════════════════════════════════════════════ */

page {
  /* 品牌色 */
  --color-brand: #FF4D6A;
  --color-brand-light: #FF8094;
  --color-brand-dark: #E83355;

  /* 背景色 */
  --color-bg: #0B0716;
  --color-bg-secondary: #110B24;
  --color-bg-tertiary: #160D2B;

  /* 卡片 & 表面 */
  --color-card: #1A1033;
  --color-card-hover: #231747;
  --color-card-active: #2D1F54;

  /* 边框 */
  --color-border: #3B285F;
  --color-border-light: #59407D;

  /* 文字 */
  --color-text-primary: #FFFFFF;
  --color-text-secondary: #D4C5EF;
  --color-text-muted: #9889B7;

  /* 语义色 */
  --color-success: #34D399;
  --color-success-bg: rgba(52, 211, 153, 0.16);
  --color-warning: #FBBF24;
  --color-warning-bg: rgba(251, 191, 36, 0.16);
  --color-error: #FB7185;
  --color-error-bg: rgba(251, 113, 133, 0.16);
  --color-info: #60A5FA;
  --color-info-bg: rgba(96, 165, 250, 0.16);

  /* 甲乙方专属色 */
  --color-party-a: #FF4D6A;
  --color-party-b: #A855F7;
  --color-score-a: #FF4D6A;
  --color-score-b: #C084FC;

  /* 聊天气泡 */
  --color-bubble-user: #FF4D6A;
  --color-bubble-ai: #1A1033;
  --color-bubble-ai-border: #3B285F;

  /* 圆角 */
  --radius-xs: 4rpx;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-full: 9999rpx;

  /* 间距 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --space-2xl: 64rpx;

  /* 字号 */
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-2xl: 44rpx;
  --font-3xl: 56rpx;

  /* 字重 */
  --font-normal: 400;
  --font-medium: 500;
  --font-semibold: 600;
  --font-bold: 700;

  /* 阴影 */
  --shadow-sm: 0 4rpx 14rpx rgba(255, 77, 106, 0.16);
  --shadow-md: 0 8rpx 28rpx rgba(168, 85, 247, 0.22);
  --shadow-lg: 0 16rpx 48rpx rgba(168, 85, 247, 0.28);

  /* 过渡 */
  --transition-fast: 0.15s ease;
  --transition-normal: 0.3s ease;
  --transition-slow: 0.5s ease;

  /* Z-index 层级 */
  --z-base: 1;
  --z-dropdown: 100;
  --z-sticky: 200;
  --z-overlay: 300;
  --z-modal: 400;
  --z-toast: 500;
}
