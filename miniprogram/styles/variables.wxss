/* ═══════════════════════════════════════════════
  啷个对 — 设计系统 CSS 变量
   V3 纸张色主题
   ═══════════════════════════════════════════════ */

page {
  /* 品牌色 */
  --color-brand: #287A65;
  --color-brand-light: #4A947F;
  --color-brand-dark: #1E5E4D;

  /* 背景色 */
  --color-bg: #F7F4EC;
  --color-bg-secondary: #EFE9DC;
  --color-bg-tertiary: #E7E0D2;

  /* 卡片 & 表面 */
  --color-card: #FFFDF8;
  --color-card-hover: #F1ECE1;
  --color-card-active: #E8E1D4;

  /* 边框 */
  --color-border: #D8D0C0;
  --color-border-light: #C7BDAA;

  /* 文字 */
  --color-text-primary: #202824;
  --color-text-secondary: #59635E;
  --color-text-muted: #7C827E;

  /* 语义色 */
  --color-success: #287A65;
  --color-success-bg: rgba(40, 122, 101, 0.12);
  --color-warning: #C9822B;
  --color-warning-bg: rgba(201, 130, 43, 0.12);
  --color-error: #B7433A;
  --color-error-bg: rgba(183, 67, 58, 0.12);
  --color-info: #376D78;
  --color-info-bg: rgba(55, 109, 120, 0.12);

  /* 甲乙方专属色 */
  --color-party-a: #287A65;
  --color-party-b: #C9822B;
  --color-score-a: #287A65;
  --color-score-b: #C9822B;

  /* 聊天气泡 */
  --color-bubble-user: #287A65;
  --color-bubble-ai: #FFFDF8;
  --color-bubble-ai-border: #D8D0C0;

  /* 圆角 */
  --radius-xs: 4rpx;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-full: 9999rpx;

  /* 间距 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --space-2xl: 64rpx;

  /* 字号 */
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-2xl: 44rpx;
  --font-3xl: 56rpx;

  /* 字重 */
  --font-normal: 400;
  --font-medium: 500;
  --font-semibold: 600;
  --font-bold: 700;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.25);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.35);

  /* 过渡 */
  --transition-fast: 0.15s ease;
  --transition-normal: 0.3s ease;
  --transition-slow: 0.5s ease;

  /* Z-index 层级 */
  --z-base: 1;
  --z-dropdown: 100;
  --z-sticky: 200;
  --z-overlay: 300;
  --z-modal: 400;
  --z-toast: 500;
}
