/* ═══════════════════════════════════════════════
   啷个对 — 全局样式
   啷个对 · 活力暗色拼贴设计系统
   ═══════════════════════════════════════════════ */

@import './styles/variables.wxss';

/* 全局重置 */
page {
  --color-brand: #FF4D6A;
  --color-brand-glow: #FF8094;
  --color-accent: #A855F7;
  --color-accent-glow: #C084FC;
  --color-bg: #0B0716;
  --color-bg-secondary: #110B24;
  --color-bg-tertiary: #160D2B;
  --color-card: #1A1033;
  --color-card-hover: #231747;
  --color-border: #3B285F;
  --color-text-primary: #FFFFFF;
  --color-text-secondary: #D4C5EF;
  --color-text-muted: #9889B7;
  --color-success: #34D399;
  --color-warning: #FBBF24;
  --color-error: #FB7185;
  --color-info: #60A5FA;
  --color-party-a: #FF4D6A;
  --color-party-b: #A855F7;
  --color-score-a: #FF4D6A;
  --color-score-b: #C084FC;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;
  --shadow-sm: 0 4rpx 14rpx rgba(255, 77, 106, 0.16);
  --shadow-md: 0 8rpx 28rpx rgba(168, 85, 247, 0.22);
  --shadow-lg: 0 16rpx 48rpx rgba(168, 85, 247, 0.28);

  background-color: var(--color-bg);
  color: var(--color-text-primary);
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 按钮按压反馈 */
.btn-primary:active,
.hero-btn:active {
  transform: scale(0.96);
  transition: transform 0.15s ease;
}

/* 全局微动效 */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

@keyframes glowPulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

/* 通用容器 */
.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

/* 按钮 */
.btn-primary {
  background: var(--color-brand);
  color: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 24rpx 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  background: transparent;
  color: var(--color-text-primary);
  border-radius: var(--radius-md);
  padding: 24rpx 48rpx;
  text-align: center;
  font-size: 30rpx;
  border: 2rpx solid var(--color-border);
}

.btn-secondary:active {
  background: var(--color-card-hover);
}

.btn-ghost {
  background: transparent;
  color: var(--color-brand);
  border-radius: var(--radius-md);
  padding: 16rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  border: none;
}

/* 文本 */
.text-primary {
  color: var(--color-text-primary);
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-muted {
  color: var(--color-text-muted);
}

.text-brand {
  color: var(--color-brand);
}

.text-success {
  color: var(--color-success);
}

.text-warning {
  color: var(--color-warning);
}

.text-error {
  color: var(--color-error);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 24rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  color: var(--color-text-muted);
}

.empty-state .icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-state .text {
  font-size: 28rpx;
  text-align: center;
}

/* 状态指示器 */
.status-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-dot.active {
  background: var(--color-success);
}

.status-dot.waiting {
  background: var(--color-warning);
}

.status-dot.inactive {
  background: var(--color-text-muted);
}

.status-dot.error {
  background: var(--color-error);
}

/* 加载动画 */
.loading-spinner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
}

/* 安全区域底部 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
