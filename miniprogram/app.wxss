/* 啷个对 V3.6 — Editorial Playfulness */
@import './styles/variables.wxss';

page {
  background: var(--color-bg);
  color: var(--color-text-primary);
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.65;
}

button,
input,
textarea { font-family: inherit; }
button::after { border: none; }

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

@keyframes glowPulse {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.container {
  min-height: 100vh;
  padding: 44rpx 36rpx;
  box-sizing: border-box;
}

.display-type { font-family: 'Songti SC', 'STSong', 'SimSun', serif; }

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.btn-primary,
.btn-secondary,
.btn-ghost {
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: transform var(--transition-fast), opacity var(--transition-fast), background var(--transition-fast);
}

.btn-primary {
  padding: 22rpx 44rpx;
  color: #F8F3EC;
  background: var(--color-brand);
  border: 0;
  border-radius: var(--radius-md);
  box-shadow: 0 16rpx 40rpx rgba(127, 53, 68, 0.25);
}

.btn-secondary {
  padding: 20rpx 42rpx;
  color: var(--color-text-primary);
  background: transparent;
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
}

.btn-ghost {
  min-height: 64rpx;
  padding: 12rpx 28rpx;
  color: var(--color-brand-light);
  background: transparent;
  border: 0;
}

.btn-primary:active,
.btn-secondary:active,
.btn-ghost:active,
.hero-cta-btn:active {
  transform: scale(0.975);
  opacity: 0.86;
}

.text-primary { color: var(--color-text-primary); }
.text-secondary { color: var(--color-text-secondary); }
.text-muted { color: var(--color-text-muted); }
.text-brand { color: var(--color-brand-light); }
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-error { color: var(--color-error); }

.divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: var(--color-border);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  color: var(--color-text-muted);
}

.status-dot {
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%;
}

.status-dot.active { background: var(--color-success); }
.status-dot.waiting { background: var(--color-warning); }
.status-dot.inactive { background: var(--color-text-muted); }
.status-dot.error { background: var(--color-error); }

.loading-spinner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
}

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
