/* ═══════════════════════════════════════════════
   AI 调解员 — 全局样式
   暗色主题设计系统
   ═══════════════════════════════════════════════ */

@import './styles/variables.wxss';

/* 全局重置 */
page {
  --color-brand: #6366F1;
  --color-bg: #111827;
  --color-bg-secondary: #1A1F2E;
  --color-card: #1F2937;
  --color-card-hover: #263244;
  --color-border: #374151;
  --color-text-primary: #F9FAFB;
  --color-text-secondary: #9CA3AF;
  --color-text-muted: #6B7280;
  --color-success: #10B981;
  --color-warning: #F59E0B;
  --color-error: #EF4444;
  --color-info: #3B82F6;
  --color-party-a: #6366F1;
  --color-party-b: #EC4899;
  --color-score-a: #6366F1;
  --color-score-b: #F472B6;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.25);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.35);

  background-color: var(--color-bg);
  color: var(--color-text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

/* 按钮 */
.btn-primary {
  background: var(--color-brand);
  color: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 24rpx 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  background: transparent;
  color: var(--color-text-primary);
  border-radius: var(--radius-md);
  padding: 24rpx 48rpx;
  text-align: center;
  font-size: 30rpx;
  border: 2rpx solid var(--color-border);
}

.btn-secondary:active {
  background: var(--color-card-hover);
}

.btn-ghost {
  background: transparent;
  color: var(--color-brand);
  border-radius: var(--radius-md);
  padding: 16rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  border: none;
}

/* 文本 */
.text-primary {
  color: var(--color-text-primary);
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-muted {
  color: var(--color-text-muted);
}

.text-brand {
  color: var(--color-brand);
}

.text-success {
  color: var(--color-success);
}

.text-warning {
  color: var(--color-warning);
}

.text-error {
  color: var(--color-error);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 24rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  color: var(--color-text-muted);
}

.empty-state .icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-state .text {
  font-size: 28rpx;
  text-align: center;
}

/* 状态指示器 */
.status-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-dot.active {
  background: var(--color-success);
}

.status-dot.waiting {
  background: var(--color-warning);
}

.status-dot.inactive {
  background: var(--color-text-muted);
}

.status-dot.error {
  background: var(--color-error);
}

/* 加载动画 */
.loading-spinner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
}

/* 安全区域底部 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
