{
  "name": "ai-mediator",
  "private": true,
  "version": "0.3.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mini": "node --test miniprogram/__tests__/mvp-integration.test.cjs miniprogram/__tests__/cloudrun-analysis.test.cjs",
    "test:cloudfunctions": "node --test cloudfunctions/scripts/__tests__/build-cf.test.cjs cloudfunctions/scripts/__tests__/case-status.test.cjs cloudfunctions/scripts/__tests__/consistency-guards.test.cjs",
    "test:cloudrun": "npm test --prefix ai-mediator-backend/cloudrun",
    "test:all": "npm test && npm run test:mini && npm run test:cloudfunctions && npm run test:cloudrun"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.15.4",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^4.1.10"
  }
}
