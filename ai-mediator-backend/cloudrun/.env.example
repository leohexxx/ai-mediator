# ═══════════════════════════════════════════════
# AI Mediator Backend — 环境变量配置
# ═══════════════════════════════════════════════

# 服务端口
PORT=9000

# ── CloudBase (腾讯云开发) ─────────────────────
# 创建 CloudRun 服务后，在云开发控制台获取
CLOUDBASE_ENV_ID=
# 服务端 API Key（推荐；SDK 自动读取，切勿提交真实值）
CLOUDBASE_APIKEY=
# 如果使用 TCB SDK 密钥方式（不用默认鉴权）：
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=

# ── LLM (DeepSeek) ────────────────────────────
# 多 key 逗号分隔，自动轮询+故障切换
LLM_API_KEYS=
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
DEEP_LLM_MODEL=deepseek-v4-pro

# ── OCR ───────────────────────────────────────
OCR_PROVIDER=tencent
OCR_MAX_CONCURRENT=4
# 腾讯高精度 OCR API 凭据
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou
OCR_MAX_IMAGES_PER_BATCH=9
OCR_MAX_IMAGES_PER_CASE=100
OCR_MAX_IMAGE_BYTES=10485760
OCR_TILE_HEIGHT=1800
OCR_TILE_OVERLAP=120
OCR_LOW_CONFIDENCE=88

# 千问视觉模型（服务端异步 OCR 主通道，真实 Key 只配置到 CloudRun）
QWEN_VISION_API_KEY=
QWEN_VISION_MODEL=qwen3.8-max
QWEN_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_TIMEOUT_MS=120000
OCR_JOB_POLL_MS=2000
OCR_JOB_LEASE_MS=600000
OCR_JOB_MAX_ATTEMPTS=2
OCR_JOB_MAX_CONCURRENT=1

# ── 视频抽帧 ──────────────────────────────────
VIDEO_MAX_FRAMES=30
VIDEO_FPS=0.5

# ── 可恢复分析作业 ─────────────────────────────
ANALYSIS_JOB_POLL_MS=5000
ANALYSIS_JOB_LEASE_MS=600000
ANALYSIS_JOB_MAX_ATTEMPTS=3
ANALYSIS_JOB_MAX_CONCURRENT=2
ANALYSIS_USER_STARTS_PER_MINUTE=5
MINIPROGRAM_STATE=developer
NOTIFICATION_INTERNAL_TOKEN=
METRICS_LOG_INTERVAL_MS=60000

# ── 本地调试模式（不通 CloudBase DB 时使用本地 JSON 文件）─
# 设为 true 可脱离 CloudBase 环境进行本地 API 调试
# 生产环境必须保持 false，并将服务访问类型配置为 MINIAPP，
# 以确保 X-Wx-Openid / X-Cloudbase-Openid 仅由 CloudBase 网关注入。
LOCAL_MODE=false
