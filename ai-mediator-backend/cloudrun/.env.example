# ═══════════════════════════════════════════════
# AI Mediator Backend — 环境变量配置
# ═══════════════════════════════════════════════

# 服务端口
PORT=9000

# ── CloudBase (腾讯云开发) ─────────────────────
# 创建 CloudRun 服务后，在云开发控制台获取
CLOUDBASE_ENV_ID=
# 如果使用 TCB SDK 密钥方式（不用默认鉴权）：
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=

# ── LLM (DeepSeek) ────────────────────────────
# 多 key 逗号分隔，自动轮询+故障切换
LLM_API_KEYS=
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
DEEP_LLM_MODEL=deepseek-v4-pro

# ── OCR ───────────────────────────────────────
# 可选: ocrspace | tencent | none
OCR_PROVIDER=ocrspace
OCR_SPACE_API_KEY=
# 腾讯OCR Secret (如果用腾讯OCR)
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=

# ── 视频抽帧 ──────────────────────────────────
VIDEO_MAX_FRAMES=30
VIDEO_FPS=0.5

# ── 可恢复分析作业 ─────────────────────────────
ANALYSIS_JOB_POLL_MS=5000
ANALYSIS_JOB_LEASE_MS=600000
ANALYSIS_JOB_MAX_ATTEMPTS=3

# ── 本地调试模式（不通 CloudBase DB 时使用本地 JSON 文件）─
# 设为 true 可脱离 CloudBase 环境进行本地 API 调试
# 生产环境必须保持 false，并将服务访问类型配置为 MINIAPP，
# 以确保 X-Wx-Openid / X-Cloudbase-Openid 仅由 CloudBase 网关注入。
LOCAL_MODE=false
